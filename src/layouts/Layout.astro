---
import { GTM_ID, APP_URL } from 'astro:env/server';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
    title?: string;
    description?: string;
    keywords?: string;
    ogTitle?: string;
    ogDescription?: string;
    ogImage?: string;
    favicon?: string;
    ogUrl?: string;
    ogType?: string;
    ogSiteName?: string;
    canonical?: string;
    jsonLd?: Record<string, unknown> | Record<string, unknown>[];
    showChrome?: boolean;
}

const {
    title = 'TVBS TECH｜權威科技媒體平台 — 半導體、AI 與產業趨勢深度報導',
    description = 'TVBS TECH 是專業、值得信賴的科技媒體平台，深度報導半導體、AI 與科技產業趨勢，涵蓋獨家專題、專家觀點與科技財經觀點，服務企業高階主管、科技從業者與投資人。',
    keywords = 'TVBS TECH,科技新聞,半導體,AI人工智慧,科技產業趨勢,亞利桑那觀察,亞利桑那投資,矽谷沙漠,台積電,科技媒體,科技財經觀點',
    ogTitle = 'TVBS TECH｜權威科技媒體平台',
    ogDescription = '深度報導半導體、AI 與科技產業趨勢，服務企業高階主管、科技從業者與投資人的專業科技媒體。',
    ogUrl = new URL(Astro.url.pathname, APP_URL).toString(),
    ogImage = new URL('/ogImage.webp', APP_URL).toString(),
    favicon = new URL('/favicon.ico', APP_URL).toString(),
    ogType = 'website',
    ogSiteName = 'TVBS TECH',
    canonical = ogUrl,
    jsonLd,
    showChrome = true,
} = Astro.props;
---
<html lang="zh-Hant">
    <head>
        <script is:inline define:vars={{ gtmId: GTM_ID }}>
            (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
            new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
            j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
            'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
            })(window,document,'script','dataLayer',gtmId);
        </script>
        <script is:inline>
            // 瀏覽器預設的 history.scrollRestoration 是 'auto'：換頁／上一頁下一頁時會嘗試「還原」
            // 使用者上次在該頁面停留的捲動位置，這個還原動作發生的時機比較晚（通常在我們自己的
            // script 執行完之後），會把 Header.astro／New.astro 為了跨頁錨點連結（例如從 /money
            // 點導覽列連回 /#spotlight）算好、瞬間跳好的正確位置又蓋回去，看起來像連結沒作用、
            // 卡在別的區塊。改成 'manual'，捲動位置完全交給我們自己的邏輯決定。
            history.scrollRestoration = 'manual';
        </script>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name="keywords" content={keywords}>
        <meta name="description" content={description}>
        <meta property="og:title" content={ogTitle}>
        <meta property="og:description" content={ogDescription}>
        <meta property="og:image" content={ogImage}>
        <meta property="og:url" content={ogUrl}>
        <meta property="og:type" content={ogType}>
        <meta property="og:site_name" content={ogSiteName}>
        <link rel="canonical" href={canonical}>
        <link rel="icon" href={favicon} type="image/x-icon">
        {jsonLd && (
            <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
        )}
    </head>
    <body>
        <noscript>
            <iframe src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`} height="0" width="0" style="display:none;visibility:hidden"></iframe>
        </noscript>
        <h1 style="display: none;">{title}</h1>
        {showChrome && <Header />}
        <main>
            <slot />
        </main>
        {showChrome && <Footer />}
    </body>
</html>
