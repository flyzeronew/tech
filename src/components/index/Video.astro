---
import '../../styles/components/index/video.css';

interface MediaItem {
    media_title: string;
    media_source: string;
    media_url: string | null;
    media_image_url: string | null;
}

interface VideoCard {
    image: string;
    title: string;
    href: string;
    isSquare: boolean;
}

let mediaItems: MediaItem[] = [];
try {
    const res = await fetch(
        `${import.meta.env.STRAPI_URL}/api/media-libraries?sort=media_published_at:desc&pagination[pageSize]=8`,
        { headers: { Authorization: `Bearer ${import.meta.env.STRAPI_API_TOKEN}` } },
    );
    if (res.ok) {
        const json = await res.json();
        mediaItems = json.data ?? [];
    }
} catch {
    mediaItems = [];
}

// media_source 不是 youtube 的（apple_podcast、firstory 等）用的是方形封面，
// 套用 is-square 置中縮放；youtube 是 16:9 縮圖，維持原本 cover 裁切
const videoItems: VideoCard[] = mediaItems.map((m) => ({
    image: m.media_image_url ?? '/video01.jpg',
    title: m.media_title,
    href: m.media_url ?? '#',
    isSquare: m.media_source !== 'youtube',
}));
---
<section data-nav="light">
    <div id="video">
        <div class="bg">
            <div class="inBox">
                <div class="itemTitle">
                    <p>精選影音</p>
                    <p>VIDEO & PODCAST</p>
                </div>
                <div class="list">
                    {videoItems.map((item) => (
                        <div class="item" class:list={{ 'is-square': item.isSquare }}>
                            <div class="imgBox">
                                <div class="img">
                                    <div class="statusIcon playIcon"></div>
                                    <img width="650" height="354" src={item.image} alt="img" loading="lazy" />
                                </div>
                                <div class="title">
                                    <p>{item.title}</p>
                                </div>
                            </div>
                        </div>
                    ))}
                    <div class="videoBlob"></div>

                </div>

                <div class="linkList">
                    <div class="linkItem">
                        <p>《科技最前線》看懂產業趨勢</p>
                        <div class="more">
                            <a href="https://www.youtube.com/watch?v=JPmb6UzzpBo&list=PLmVlUjKuEG7SikBn4h8gZKuN0gn_yxetj" target="_blank" rel="noopener noreferrer">
                                <span>前往 YouTube 頻道</span>
                                <div class="arraw">
                                    <img width="28" height="28" src="/arraw-right-03.svg" alt="arraw" />
                                </div>
                            </a>
                        </div>
                    </div>
                    <div class="linkItem">
                        <p>《新聞幕後》聽懂科技趨勢</p>
                        <div class="more">
                            <a href="https://www.youtube.com/results?search_query=%E6%96%B0%E8%81%9E%E5%B9%95%E5%BE%8C" target="_blank" rel="noopener noreferrer">
                                <span>前往 Podcast 頻道</span>
                                <div class="arraw">
                                    <img width="28" height="28" src="/arraw-right-03.svg" alt="arraw" />
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<script>
    // ===== 精選影音（#video）背景藍色光暈 =====
    // 1. 頁面一載入就播放：光暈從畫面外右上方滑進來，先到畫面正中間，停一下再移到第一張圖片，才開放 hover。
    //    不需要像 #issue／#crossover／#publications 那樣等區塊捲到頂端才觸發。
    // 2. hover 到任一張圖片時，光暈平滑移動到那張圖片底下置中。
    const videoEl = document.getElementById('video');
    const list = videoEl?.querySelector<HTMLElement>('.list');
    const blob = list?.querySelector<HTMLElement>('.videoBlob');
    const items = list ? Array.from(list.querySelectorAll<HTMLElement>('.item')) : [];

    if (videoEl && list && blob && items.length) {
        // 把光暈置中在某個「目標矩形」正中間所需的 left/top（用 % 表示，相對 .list）
        function centerOn(targetLeft: number, targetTop: number, targetWidth: number, targetHeight: number) {
            const listRect = list!.getBoundingClientRect();
            const blobRect = blob!.getBoundingClientRect();
            const centerX = targetLeft + targetWidth / 2;
            const centerY = targetTop + targetHeight / 2;
            const left = ((centerX - blobRect.width / 2) / listRect.width) * 100;
            const top = ((centerY - blobRect.height / 2) / listRect.height) * 100;
            blob!.style.left = `${left}%`;
            blob!.style.top = `${top}%`;
        }

        function moveBlobTo(item: HTMLElement) {
            const listRect = list!.getBoundingClientRect();
            const itemRect = item.getBoundingClientRect();
            centerOn(itemRect.left - listRect.left, itemRect.top - listRect.top, itemRect.width, itemRect.height);
        }

        function moveBlobToCenter() {
            const listRect = list!.getBoundingClientRect();
            centerOn(0, 0, listRect.width, listRect.height);
        }

        // 手機版目前有些卡片是 display:none（見 video.css 1024px 以下的規則），
        // items[0] 在 DOM 順序上不一定是「第一個看得到的」卡片——offsetParent 在 display:none 時會是 null，
        // 用這個判斷可以動態找到當下斷點實際顯示的第一張卡片，桌機/手機都適用
        function getFirstVisibleItem(): HTMLElement | undefined {
            return items.find((item) => item.offsetParent !== null);
        }

        let hoverEnabled = false;
        items.forEach((item) => {
            item.addEventListener('mouseenter', () => {
                if (hoverEnabled) moveBlobTo(item);
            });
        });
        list.addEventListener('mouseleave', () => {
            const firstVisible = getFirstVisibleItem();
            if (hoverEnabled && firstVisible) moveBlobTo(firstVisible);
        });

        function playEnter() {
            // 先瞬間（關掉 transition）把光暈擺到「畫面外右上方」的起始位置，
            // 強制 reflow 讓這個瞬間定位先生效，接著恢復 transition，會是從右上往下滑入的效果。
            blob!.style.transition = 'none';
            blob!.style.left = '70%';
            blob!.style.top = '-50%';
            blob!.style.opacity = '0';
            void blob!.offsetWidth; // 強制 reflow
            blob!.style.transition = '';

            // 第一段：滑到畫面正中間、同時淡入
            requestAnimationFrame(() => {
                moveBlobToCenter();
                blob!.style.opacity = '1';
            });

            // 第二段：停留一下之後，才接著移到第一張看得到的圖片
            window.setTimeout(() => {
                const firstVisible = getFirstVisibleItem();
                if (firstVisible) moveBlobTo(firstVisible);
            }, 700);

            // 兩段動畫都播完（跟 CSS transition 時間 0.5s 對齊，留一點餘裕）才開放 hover
            window.setTimeout(() => { hoverEnabled = true; }, 1300);
        }

        // 不用等區塊捲到頂端，頁面一載入就直接播放光暈進場動畫
        playEnter();
    }
</script>
