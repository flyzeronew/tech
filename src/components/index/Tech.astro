---
import { STRAPI_URL, STRAPI_API_TOKEN } from 'astro:env/server';
import '../../styles/components/index/tech.css';
import { resolveSummary } from '../../lib/articleSummary';
import { resolveArticleImage, type RawNewsImage } from '../../lib/articleImage';
import { cachedFetchJson, CACHE_TTL } from '../../lib/fetchCache';

interface TechArticle {
    id: number;
    news_article_id: string;
    news_title: string;
    news_content_html: string | null;
    news_summary: string | null;
    news_featured_image_url: string | null;
    news_image: RawNewsImage[] | null;
    news_published_at: string | null;
}

interface TechCard {
    date: string;
    title: string;
    description: string;
    image: string;
    href: string;
}

function formatDate(iso: string | null): string {
    if (!iso) return '';
    const d = new Date(iso);
    return `${d.getFullYear()}/${String(d.getMonth() + 1).padStart(2, '0')}/${String(d.getDate()).padStart(2, '0')}`;
}

// news_summary 是後台可選填的摘要欄位，優先用它；沒填才退回用 news_content_html 截斷全文
function stripHtml(html: string | null, maxLength: number): string {
    if (!html) return '';
    const text = html.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
    return text.length > maxLength ? `${text.slice(0, maxLength)}…` : text;
}

const MAX_ITEMS = 6;

// 後台可在 everyday_tech 手動挑選文章；選不足 6 則時，用 tech 分類最新文章遞補到滿 6 則
// （已手動選過的文章不會在遞補清單中重複出現），全部連到 /tech/{id} 內頁
let pickedItems: TechArticle[] = [];
try {
    const json = await cachedFetchJson<{ data?: { everyday_tech?: TechArticle[] } }>(
        `${STRAPI_URL}/api/index-page?populate[everyday_tech][fields][0]=news_title&populate[everyday_tech][fields][1]=news_featured_image_url&populate[everyday_tech][fields][2]=news_published_at&populate[everyday_tech][fields][3]=news_content_html&populate[everyday_tech][fields][4]=news_summary&populate[everyday_tech][fields][5]=news_article_id` +
            `&populate[everyday_tech][populate][news_image][fields][0]=url`,
        { headers: { Authorization: `Bearer ${STRAPI_API_TOKEN}` } },
        CACHE_TTL.NAV,
    );
    pickedItems = (json?.data?.everyday_tech ?? []).slice(0, MAX_ITEMS);
} catch {
    pickedItems = [];
}

let techArticles: TechArticle[] = pickedItems;
if (pickedItems.length < MAX_ITEMS) {
    try {
        const pickedIds = new Set(pickedItems.map((a) => a.news_article_id));
        const json = await cachedFetchJson<{ data?: TechArticle[] }>(
            `${STRAPI_URL}/api/article-libs?filters[news_category][$eq]=tech&sort=news_published_at:desc&pagination[pageSize]=${MAX_ITEMS}` +
                `&fields[0]=news_title&fields[1]=news_featured_image_url&fields[2]=news_published_at&fields[3]=news_content_html&fields[4]=news_summary&fields[5]=news_article_id` +
                `&populate[news_image][fields][0]=url`,
            { headers: { Authorization: `Bearer ${STRAPI_API_TOKEN}` } },
            CACHE_TTL.NEWS,
        );
        const fillers = (json?.data ?? []).filter((a) => !pickedIds.has(a.news_article_id));
        techArticles = [...pickedItems, ...fillers.slice(0, MAX_ITEMS - pickedItems.length)];
    } catch {
        // 遞補失敗就只顯示手動選的文章，不讓整區塊掛掉
    }
}

const newsCards: TechCard[] = techArticles.map((a) => ({
    date: formatDate(a.news_published_at),
    title: a.news_title,
    description: resolveSummary(a.news_summary, stripHtml(a.news_content_html, 60)),
    image: resolveArticleImage(a.news_image, a.news_featured_image_url, '/news-image-01.jpg'),
    href: `/tech/${a.news_article_id}`,
}));
---
<section data-nav="light">
    <div id="tech">
        <div class="inBox">
            <div class="titleBox">
                <div class="itemTitle">
                    <p>科技生活</p>
                    <p>EVERYDAY TECH</p>
                </div>
                <div class="more">
                    <a href="/tech">                         
                        <span class="pc">更多科技生活</span> 
                        <span class="mobile">更多</span>                
                        <div class="arraw">
                            <img width="28" height="28" src="/arraw-right-02.svg" alt="arraw" />
                        </div>
                    </a>
                </div>
            </div>

            <div class="newslist">
                <ul>
                    {newsCards.map((card) => (
                        <li>
                            <a href={card.href}>
                                <div class="date">{card.date}</div>
                                <div class="news">
                                    <div class="img">
                                        <img width="96" height="54" src={card.image} alt="arraw" loading="lazy" />
                                    </div>
                                    <div class="titleBox">
                                        <div class="time">{card.date}</div>
                                        <div class="title">{card.title}</div>
                                        <div class="description">{card.description}</div>
                                    </div>
                                </div>
                                <div class="arraw">
                                    <img width="24" height="24 " src="/arraw-right-02.svg" alt="arraw" />
                                </div>
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        </div>
    </div>
</section>
