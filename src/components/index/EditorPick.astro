---
import { STRAPI_URL, STRAPI_API_TOKEN } from 'astro:env/server';
import '../../styles/components/index/editor-pick.css';
import { resolveArticleLink } from '../../lib/articleLink';
import { resolveSummary } from '../../lib/articleSummary';
import { resolveArticleImage, type RawNewsImage } from '../../lib/articleImage';
import { cachedFetchJson, CACHE_TTL } from '../../lib/fetchCache';

interface EditorImage {
    url: string;
}

interface EditorProfile {
    author_name: string;
    author_tag: string | null;
    author_job_title: string | null;
    author_image: EditorImage | null;
}

interface TitleArticleNews {
    id: number;
    news_article_id: string;
    news_title: string;
    news_category: string | null;
    news_content_html: string | null;
    news_summary: string | null;
    news_featured_image_url: string | null;
    news_image: RawNewsImage[] | null;
    news_article_url: string | null;
}

interface TitleArticle {
    tiitle: string;
    summary: string;
    article: TitleArticleNews | null;
}

interface EditorZone {
    editor_qruote: string | null;
    editor_title: string | null;
    editor_description: string | null;
    efitor: EditorProfile | null;
    tiitle_article: TitleArticle[] | null;
}

interface PickCard {
    projectTitle: string;
    projectSummary: string;
    tag: string;
    title: string;
    description: string;
    image: string;
    href: string;
    external: boolean;
}

// news_summary 是後台可選填的摘要欄位，優先用它；沒填才退回用 news_content_html 截斷全文
function stripHtml(html: string | null, maxLength: number): string {
    if (!html) return '';
    const text = html.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
    return text.length > maxLength ? `${text.slice(0, maxLength)}…` : text;
}

let editorZone: EditorZone | null = null;
try {
    const json = await cachedFetchJson<{ data?: { s9_1_editor_zone?: EditorZone | null } }>(
        `${STRAPI_URL}/api/index-page?populate[s9_1_editor_zone][populate][efitor][populate]=*` +
            `&populate[s9_1_editor_zone][populate][tiitle_article][populate][article][fields][0]=news_title` +
            `&populate[s9_1_editor_zone][populate][tiitle_article][populate][article][fields][1]=news_content_html` +
            `&populate[s9_1_editor_zone][populate][tiitle_article][populate][article][fields][2]=news_featured_image_url` +
            `&populate[s9_1_editor_zone][populate][tiitle_article][populate][article][fields][3]=news_article_url` +
            `&populate[s9_1_editor_zone][populate][tiitle_article][populate][article][fields][4]=news_category` +
            `&populate[s9_1_editor_zone][populate][tiitle_article][populate][article][fields][5]=news_summary` +
            `&populate[s9_1_editor_zone][populate][tiitle_article][populate][article][fields][6]=news_article_id` +
            `&populate[s9_1_editor_zone][populate][tiitle_article][populate][article][populate][news_image][fields][0]=url`,
        { headers: { Authorization: `Bearer ${STRAPI_API_TOKEN}` } },
        CACHE_TTL.NAV,
    );
    editorZone = json?.data?.s9_1_editor_zone ?? null;
} catch {
    editorZone = null;
}

const editor = editorZone?.efitor ?? null;
const editorName = editor?.author_name ?? '';
const editorJob = editor?.author_tag
    ? editor.author_tag.split(',').map((t) => t.trim()).filter(Boolean).join('・')
    : '';
// author_job_title 後台實際存放的是簡介文字（不是職稱），依內容比對而非欄位名稱決定用途
const editorDescription = editor?.author_job_title ?? '';
const rawEditorImage = editor?.author_image?.url ?? null;
const editorImage = rawEditorImage
    ? (rawEditorImage.startsWith('http') ? rawEditorImage : `${STRAPI_URL}${rawEditorImage}`)
    : '/expert02.jpg';

const motto = editorZone?.editor_qruote ?? '';
const pickTitle = editorZone?.editor_title ?? '';
const pickDescription = editorZone?.editor_description ?? '';

const pickCards: PickCard[] = (editorZone?.tiitle_article ?? [])
    .filter((item): item is TitleArticle & { article: TitleArticleNews } => item.article !== null)
    .map((item) => {
        const link = resolveArticleLink(item.article.news_category, item.article.news_article_id, item.article.news_article_url);
        return {
            projectTitle: item.tiitle,
            projectSummary: item.summary,
            tag: '專題',
            title: item.article.news_title,
            description: resolveSummary(item.article.news_summary, stripHtml(item.article.news_content_html, 60)),
            image: resolveArticleImage(item.article.news_image, item.article.news_featured_image_url, '/issue-image-01.jpg'),
            href: link.href,
            external: link.external,
        };
    });
---
<section data-nav="dark">
    <div id="pick">
        <div class="inBox">
            <div class="titleBox">
                <div class="itemTitle">
                    <p>編輯選讀</p>
                    <p>EDITOR'S PICK</p>
                </div>
            </div>
            <div class="flex align-center">
                <div class="editor">
                    <div class="img">
                        <img width="400" height="400" src={editorImage} alt={editorName} loading="lazy" />
                    </div>
                    <div class="txtBox">
                        <div class="info">
                            <div class="name">
                                {editorName}
                            </div>
                            <div class="job">
                                {editorJob}
                            </div>
                            <div class="description">
                                {editorDescription}
                            </div>
                        </div>
                    </div>
                </div>
                <div class="motto">
                    {motto}
                </div>
            </div>

            <div class="moreArea">
                <div class="areaTitleBox">
                    <div class="title">
                        {pickTitle}
                    </div>
                    <div class="description">
                        <p>
                            {pickDescription}
                        </p>
                        <div class="btn">
                            <button type="button" class="prevBtn" aria-label="上一個">
                                <img width="20" height="20" src="/arraw-right-02.svg" alt="prev" />
                            </button>
                            <button type="button" class="nextBtn" aria-label="下一個">
                                <img width="20" height="20" src="/arraw-right-02.svg" alt="next" />
                            </button>
                        </div>
                    </div>
                </div>
                <div class="list">
                    <swiper-container init="false" class="moreSwiper">
                        {pickCards.map((card) => (
                            <swiper-slide>
                                <div class="project">
                                    <div class="title">
                                        {card.projectTitle}
                                    </div>
                                    <div class="description">
                                        {card.projectSummary}
                                    </div>
                                </div>
                                <a class="box" href={card.href} target={card.external ? '_blank' : undefined} rel={card.external ? 'noopener noreferrer' : undefined}>
                                    <div class="img">
                                        <img width="800" height="450" src={card.image} alt="img" loading="lazy" />
                                        <div class="cardArraw">
                                            <img width="28" height="28" src="/arraw-right-01.svg" alt="arraw" />
                                        </div>
                                    </div>
                                    <div class="txtBox">
                                        <div class="tag">{card.tag}</div>
                                        <div class="title">
                                            {card.title}
                                        </div>
                                        <div class="description">
                                            {card.description}
                                        </div>
                                    </div>
                                </a>
                            </swiper-slide>
                        ))}
                    </swiper-container>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    // ===== 編輯選讀（#pick）影響 AI 的十件事清單：改用 Swiper 輪播套件 =====
    import { register } from 'swiper/element/bundle';
    register();

    const moreSwiperEl = document.querySelector<HTMLElement & { initialize: () => void }>('.moreSwiper');
    if (moreSwiperEl) {
        Object.assign(moreSwiperEl, {
            slidesPerView: 'auto',
            spaceBetween: 20,
            loop: true,
            navigation: {
                nextEl: '#pick .moreArea .btn .nextBtn',
                prevEl: '#pick .moreArea .btn .prevBtn',
            },
        });
        moreSwiperEl.initialize();
        // 初始化完成後才淡入，避免重新整理時先閃一下未套用輪播樣式的原始版面
        moreSwiperEl.classList.add('is-ready');
    }
</script>
