---
import { STRAPI_URL, STRAPI_API_TOKEN } from 'astro:env/server';
import '../../styles/components/index/hero.css';
import { resolveArticleLink } from '../../lib/articleLink';
import { resolveSummary } from '../../lib/articleSummary';
import { resolveArticleImage, type RawNewsImage } from '../../lib/articleImage';
import { cachedFetchJson, CACHE_TTL } from '../../lib/fetchCache';

interface ArticleBlockData {
    id: number;
    news_article_id: string;
    news_title: string;
    news_category: string | null;
    news_content_html: string | null;
    news_summary: string | null;
    news_featured_image_url: string | null;
    news_image: RawNewsImage[] | null;
    news_published_at: string | null;
    news_article_url: string | null;
}

interface MediaBlockData {
    media_title: string;
    media_source: string | null;
    media_image_url: string | null;
    media_published_at: string | null;
    media_url: string | null;
}

interface ArticleBlock {
    __component: 'shared.article-block';
    article_block: ArticleBlockData | null;
}

interface MediaBlock {
    __component: 'shared.media-block';
    media_block: MediaBlockData | null;
}

type HeroZoneItem = ArticleBlock | MediaBlock;

interface HeroCard {
    tag: string;
    title: string;
    description: string;
    image: string;
    date: string;
    href: string;
    external: boolean;
}

function formatDate(iso: string | null): string {
    if (!iso) return '';
    const d = new Date(iso);
    return `${d.getFullYear()}/${String(d.getMonth() + 1).padStart(2, '0')}/${String(d.getDate()).padStart(2, '0')}`;
}

// news_summary 是後台可選填的摘要欄位，優先用它；沒填才退回用 news_content_html 截斷全文
function stripHtml(html: string | null, maxLength: number): string {
    if (!html) return '';
    const text = html.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
    return text.length > maxLength ? `${text.slice(0, maxLength)}…` : text;
}

function toCard(item: HeroZoneItem): HeroCard | null {
    if (item.__component === 'shared.article-block' && item.article_block) {
        const a = item.article_block;
        const link = resolveArticleLink(a.news_category, a.news_article_id, a.news_article_url);
        return {
            tag: a.news_category ?? '',
            title: a.news_title,
            description: resolveSummary(a.news_summary, stripHtml(a.news_content_html, 100)),
            image: resolveArticleImage(a.news_image, a.news_featured_image_url, '/main-view-01.jpg'),
            date: formatDate(a.news_published_at),
            href: link.href,
            external: link.external,
        };
    }
    if (item.__component === 'shared.media-block' && item.media_block) {
        const m = item.media_block;
        return {
            tag: m.media_source ?? '',
            title: m.media_title,
            description: '',
            image: m.media_image_url ?? '/main-view-01.jpg',
            date: formatDate(m.media_published_at),
            href: m.media_url ?? '#',
            external: true,
        };
    }
    return null;
}

let heroCards: HeroCard[] = [];
try {
    const json = await cachedFetchJson<{ data?: { hero_zone?: HeroZoneItem[] } }>(
        `${STRAPI_URL}/api/hero-zone?populate[hero_zone][on][shared.article-block][populate][article_block][populate][news_image][fields][0]=url` +
            `&populate[hero_zone][on][shared.media-block][populate]=media_block`,
        { headers: { Authorization: `Bearer ${STRAPI_API_TOKEN}` } },
        CACHE_TTL.NAV,
    );
    const items: HeroZoneItem[] = json?.data?.hero_zone ?? [];
    heroCards = items.map(toCard).filter((c): c is HeroCard => c !== null);
} catch {
    heroCards = [];
}

const [kvCard, ...listCards] = heroCards;
---
<section>
    <div id="hero">
        <div class="kv">
            <div class="box">
                <div class="img" data-nav="dark">
                    <img width="1440" height="400" src={kvCard?.image ?? '/main-view-01.jpg'} alt="kv" />
                </div>
                <div class="txtBox" data-nav="light">
                    <div class="inBox" >
                        <div class="itemTitle animLabel">
                            <p>科技頭條</p>
                            <p>MUST-READ</p>
                        </div>
                        <div class="newsBox type2">
                            <div class="tag">
                                {kvCard?.tag}
                            </div>
                            <div class="title">
                                {kvCard?.title}
                            </div>
                            <div class="description">
                                {kvCard?.description}
                            </div>
                            <div class="more">
                                <a href={kvCard?.href ?? '#'} target={kvCard?.external === false ? undefined : '_blank'} rel={kvCard?.external === false ? undefined : 'noopener noreferrer'}>
                                    <span>閱讀完整報導</span>
                                    <div class="arraw">
                                        <img width="28" height="28" src="/arraw-right-01.svg" alt="arraw" />
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="newslist type2">
            <div class="inBox">
                <ul>
                    {listCards.map((card) => (
                        <li>
                            <a href={card.href} target={card.external ? '_blank' : undefined} rel={card.external ? 'noopener noreferrer' : undefined}>
                                <div class="date">{card.date}</div>
                                <div class="news">
                                    <div class="img">
                                        <img width="96" height="54" src={card.image} alt="arraw" loading="lazy" />
                                    </div>
                                    <div class="titleBox">
                                        <div class="tag">
                                            {card.tag}
                                        </div>
                                        <div class="time">
                                            {card.date}
                                        </div>
                                        <div class="title">
                                            {card.title}
                                        </div>
                                    </div>
                                </div>
                                <div class="arraw">
                                    <img width="24" height="24 " src="/arraw-right-02.svg" alt="arraw" />
                                </div>
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        </div>
    </div>
</section>
