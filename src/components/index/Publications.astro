---
import { STRAPI_URL, STRAPI_API_TOKEN } from 'astro:env/server';
import '../../styles/components/index/publications.css';
import { cachedFetchJson, CACHE_TTL } from '../../lib/fetchCache';

interface BookZoneItem {
    book_name: string;
    book_description: string | null;
    book_url: string | null;
    book_image: { url: string } | null;
}

interface BookCard {
    title: string;
    description: string;
    href: string;
    image: string;
}

let bookItems: BookZoneItem[] = [];
try {
    const json = await cachedFetchJson<{ data?: { publications?: BookZoneItem[] } }>(
        `${STRAPI_URL}/api/index-page?populate[publications][populate]=book_image`,
        { headers: { Authorization: `Bearer ${STRAPI_API_TOKEN}` } },
        CACHE_TTL.NAV,
    );
    bookItems = json?.data?.publications ?? [];
} catch {
    bookItems = [];
}

const bookCards: BookCard[] = bookItems.map((b) => ({
    title: b.book_name,
    description: b.book_description ?? '',
    href: b.book_url ?? '#',
    image: b.book_image?.url
        ? (b.book_image.url.startsWith('http') ? b.book_image.url : `${STRAPI_URL}${b.book_image.url}`)
        : '/real-book1.png',
}));

// 每個 <li> 書架區塊除了一本後台真實資料的書（.book.real）外，前面會擺幾本純裝飾用的書背（book1~9.png）撐場面，
// 書本數量不固定（後台可能新增/減少），所以裝飾書背的數量與圖片改用 index 循環決定，而不是寫死 4 組
const FILLER_IMAGES = ['/book1.png', '/book2.png', '/book3.png', '/book4.png', '/book5.png', '/book6.png', '/book7.png', '/book8.png', '/book9.png'];
const FILLER_COUNTS = [3, 4, 5, 4];

function getFillers(index: number): string[] {
    const count = FILLER_COUNTS[index % FILLER_COUNTS.length];
    return Array.from({ length: count }, (_, j) => FILLER_IMAGES[(index * 3 + j) % FILLER_IMAGES.length]);
}
---
<section data-nav="light">
    <div id="publications">
        <div class="inBox">
            <div class="titleBox">
                <div class="itemTitle">
                    <p>精選出版品</p>
                    <p>PUBLICATIONS</p>
                </div>
                <div class="more">
                    <a href="https://www.books.com.tw/web/sys_puballb/books/?pubid=tvbscomtw" target="_blank" rel="noopener noreferrer">                        
                        <span class="pc">全部出版品</span> 
                        <span class="mobile">更多</span> 
                        <div class="arraw">
                            <img width="28" height="28" src="/arraw-right-02.svg" alt="arraw" />
                        </div>
                    </a>
                </div>
            </div>
            <div class="books">
                <ul>
                    {bookCards.map((book, i) => (
                        <li>
                            {getFillers(i).map((src, j) => (
                                <div class="book">
                                    <img width={j === 0 ? 100 : 52} height={j === 0 ? 499 : 480} src={src} alt="book" loading="lazy" />
                                </div>
                            ))}
                            <div class="book real">
                                <div class="img">
                                    <img width="52" height="480" src={book.image} alt="book" loading="lazy" />
                                </div>
                                <div class="txtBox">
                                    <div class="title">
                                        {book.title}
                                    </div>
                                    <div class="description">
                                        {book.description}
                                    </div>
                                    <div class="more">
                                        <a href={book.href} target="_blank" rel="noopener noreferrer">
                                            <span>前往博客來</span>
                                            <div class="arraw">
                                                <img width="28" height="28" src="/arraw-right-01.svg" alt="arraw" />
                                            </div>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </li>
                    ))}
                </ul>
            </div>
            <!-- 768px 以下：書架下方共用的資訊面板，點選書本時把該本書的 txtBox 內容置換進來 -->
            <div class="booksInfoPanel"></div>
            <div class="booksNav">
                <button type="button" class="booksPrev" aria-label="上一個">
                    <img width="20" height="20" src="/arraw-right-02.svg" alt="prev" />
                </button>
                <button type="button" class="booksNext" aria-label="下一個">
                    <img width="20" height="20" src="/arraw-right-02.svg" alt="next" />
                </button>
            </div>
        </div>
    </div>
</section>

<script>
    // ===== 精選出版品（#publications）書本清單：無限循環自動捲動、拖曳、左右按鈕 =====
    const books = document.querySelector<HTMLElement>('#publications .books');
    const booksList = books?.querySelector<HTMLUListElement>('ul');

    if (books && booksList) {
        // 複製一份清單內容接在後面，捲到一半時無縫接回開頭，做出無限循環的效果
        const originalItems = Array.from(booksList.children);
        originalItems.forEach((item) => {
            const clone = item.cloneNode(true) as HTMLElement;
            clone.setAttribute('aria-hidden', 'true');
            booksList.appendChild(clone);
        });

        let isDown = false;
        let isHover = false;
        let isTouching = false;
        let startX = 0;
        let scrollStart = 0;
        // 單純點擊（例如點書本上的「前往博客來」連結）也會先觸發 pointerdown，
        // 如果一按下就立刻 setPointerCapture，之後的 click 事件會被整個 .books 容器搶走，
        // 連結就永遠點不出去（hover 仍能看到網址，因為那是瀏覽器原生行為，跟 JS 無關）。
        // 改成移動超過門檻才視為「真的在拖曳」，此時才 setPointerCapture、套用捲動；
        // 沒超過門檻就當作一般點擊放行，讓底下的連結能正常收到 click。
        const DRAG_THRESHOLD = 5;
        let hasDragged = false;
        let activePointerId: number | null = null;

        // 圖片預設可以被瀏覽器原生拖曳，會打斷我們自己的拖曳捲動，這裡直接擋掉
        books.addEventListener('dragstart', (e) => e.preventDefault());

        books.addEventListener('pointerdown', (e) => {
            if (e.pointerType === 'touch') return; // 手機／觸控裝置改用瀏覽器原生的觸控捲動（見下方 touchstart／touchend）
            isDown = true;
            hasDragged = false;
            activePointerId = e.pointerId;
            startX = e.clientX;
            scrollStart = books.scrollLeft;
        });

        books.addEventListener('pointermove', (e) => {
            if (!isDown) return;
            const delta = e.clientX - startX;
            if (!hasDragged) {
                if (Math.abs(delta) < DRAG_THRESHOLD) return;
                hasDragged = true;
                books.classList.add('dragging');
                books.setPointerCapture(e.pointerId);
            }
            books.scrollLeft = scrollStart - delta;
        });

        let scrollPos = books.scrollLeft;

        const endDrag = () => {
            if (hasDragged && activePointerId !== null && books.hasPointerCapture(activePointerId)) {
                books.releasePointerCapture(activePointerId);
            }
            isDown = false;
            hasDragged = false;
            activePointerId = null;
            books.classList.remove('dragging');
            scrollPos = books.scrollLeft;
        };

        books.addEventListener('pointerup', endDrag);
        books.addEventListener('pointercancel', endDrag);
        books.addEventListener('pointerleave', endDrag);

        books.addEventListener('pointerenter', () => { isHover = true; });
        books.addEventListener('pointerleave', () => { isHover = false; });

        // 原生觸控捲動一旦開始，瀏覽器很快就會對 touch 的 pointer 發出 pointercancel（把控制權交給原生捲動），
        // 如果用 pointer 事件判斷「是否還在觸控」，會在手指其實還在滑動時就被提早重設，
        // 自動捲動因此提早恢復、跟使用者的手勢互搶 scrollLeft，感覺像是「拉不動」。
        // touchstart／touchend／touchcancel 會貫穿整個手勢、不會被提前取消，才拿來判斷是否要暫停自動捲動。
        const endTouch = () => {
            isTouching = false;
            scrollPos = books.scrollLeft;
        };
        books.addEventListener('touchstart', () => { isTouching = true; }, { passive: true });
        books.addEventListener('touchend', endTouch, { passive: true });
        books.addEventListener('touchcancel', endTouch, { passive: true });

        let isManual = false;

        // 手機版畫面較窄，同樣的像素速度感覺比桌機慢很多，這裡加快一點
        const mobileSpeedQuery = window.matchMedia('(max-width: 1023px)');
        function getSpeed() {
            return mobileSpeedQuery.matches ? 0.4 : 0.3; // 每禎捲動的像素數
        }
        function autoScroll() {
            const loopWidth = booksList.scrollWidth / 2;
            if (!isDown && !isHover && !isManual && !isTouching) {
                // scrollLeft 在某些瀏覽器會被四捨五入成整數，直接用它累加小數會卡住，
                // 所以改用獨立變數保留完整精度，只在寫入時才套用到 scrollLeft
                scrollPos += getSpeed();
                if (scrollPos >= loopWidth) {
                    scrollPos -= loopWidth;
                }
                books.scrollLeft = scrollPos;
            }
            requestAnimationFrame(autoScroll);
        }
        requestAnimationFrame(autoScroll);

        // 左右按鍵：把目前位置平滑捲動到目標位置
        const step = 300;
        let scrollAnimFrame: number | null = null;
        function animateScrollBy(delta: number, duration = 400) {
            if (scrollAnimFrame !== null) {
                cancelAnimationFrame(scrollAnimFrame);
                scrollAnimFrame = null;
            }
            isManual = true;
            const loopWidth = booksList.scrollWidth / 2;
            // 用畫面上「當下實際」的捲動位置當起點，避免連續點擊時從過期的 scrollPos 起跳造成跳動
            const start = books.scrollLeft;
            const target = start + delta;
            const startTime = performance.now();

            function tick(now: number) {
                const t = Math.min((now - startTime) / duration, 1);
                const eased = 1 - Math.pow(1 - t, 3);
                let pos = start + (target - start) * eased;
                if (pos < 0) pos += loopWidth;
                if (pos >= loopWidth) pos -= loopWidth;
                books.scrollLeft = pos;
                if (t < 1) {
                    scrollAnimFrame = requestAnimationFrame(tick);
                } else {
                    scrollPos = pos;
                    isManual = false;
                    scrollAnimFrame = null;
                }
            }
            scrollAnimFrame = requestAnimationFrame(tick);
        }

        const prevBtn = document.querySelector<HTMLButtonElement>('#publications .booksPrev');
        const nextBtn = document.querySelector<HTMLButtonElement>('#publications .booksNext');
        prevBtn?.addEventListener('click', () => animateScrollBy(-step));
        nextBtn?.addEventListener('click', () => animateScrollBy(step));
    }

    // ===== 768px 以下：點選書本，資訊置換到書架下方的共用面板 =====
    // 桌機／1024px 以下用 hover 在書本原地彈出 txtBox；768px 以下改成點選後
    // 把該本書 txtBox 裡的內容（標題／簡介／連結）複製一份塞進書架下方固定的面板，
    // 面板本身只有一個，每次點選就整個換掉內容，而不是每本書各自彈出。
    const booksInfoPanel = document.querySelector<HTMLElement>('#publications .booksInfoPanel');
    const bookReals = document.querySelectorAll<HTMLElement>('#publications .books .book.real');
    if (booksInfoPanel && bookReals.length) {
        // 換內容前先淡出，等淡出動畫播完才真正替換內容、再淡入，避免內容瞬間跳掉
        let fadeTimer: number | undefined;
        function showInPanel(html: string) {
            window.clearTimeout(fadeTimer);
            booksInfoPanel!.style.opacity = '0';
            fadeTimer = window.setTimeout(() => {
                booksInfoPanel!.innerHTML = html;
                booksInfoPanel!.style.opacity = '1';
            }, 250);
        }
        bookReals.forEach((book) => {
            const trigger = book.querySelector<HTMLElement>('.img');
            const txtBox = book.querySelector<HTMLElement>('.txtBox');
            trigger?.addEventListener('click', () => {
                if (!txtBox) return;
                showInPanel(txtBox.innerHTML);
            });
        });
    }
</script>
