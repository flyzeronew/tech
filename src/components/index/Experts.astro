---
import { STRAPI_URL, STRAPI_API_TOKEN } from 'astro:env/server';
import '../../styles/components/index/experts.css';
import { experts as expertsData } from '../../data/experts';
import { resolveArticleLink } from '../../lib/articleLink';
import { cachedFetchJson, CACHE_TTL } from '../../lib/fetchCache';

interface AuthorArticle {
    id: number;
    news_article_id: string;
    news_title: string;
    news_article_url: string | null;
    news_category: string | null;
}

interface AuthorImage {
    url: string;
}

interface AuthorProfile {
    author_name: string;
    author_tag: string | null;
    author_job_title: string | null;
    author_image: AuthorImage | null;
}

interface AuthorColumnItem {
    author: AuthorProfile | null;
    author_article: AuthorArticle[] | null;
}

interface ExpertCard {
    slug: string;
    name: string;
    tags: string[];
    description: string;
    avatar: string;
    articles: { title: string; href: string; external: boolean }[];
}

let authorColumns: AuthorColumnItem[] = [];
try {
    const json = await cachedFetchJson<{ data?: { s5_author_column?: AuthorColumnItem[] } }>(
        `${STRAPI_URL}/api/index-page?populate[s5_author_column][populate][author][populate]=*&populate[s5_author_column][populate][author_article][fields][0]=news_title&populate[s5_author_column][populate][author_article][fields][1]=news_article_url&populate[s5_author_column][populate][author_article][fields][2]=news_category&populate[s5_author_column][populate][author_article][fields][3]=news_article_id`,
        { headers: { Authorization: `Bearer ${STRAPI_API_TOKEN}` } },
        CACHE_TTL.NAV,
    );
    authorColumns = json?.data?.s5_author_column ?? [];
} catch {
    authorColumns = [];
}

// 後台「作者庫」目前沒有獨立的 slug 欄位，靠姓名比對 src/data/experts.ts 既有的 slug
// 才能連到 /experts/[slug] 詳細頁，跟 experts.astro 列表頁的做法一致。
function findSlug(authorName: string): string {
    const match = expertsData.find((e) => {
        const full = `${e.firstName}${e.lastName}`;
        const spaced = `${e.firstName} ${e.lastName}`;
        return full === authorName || spaced === authorName;
    });
    return match?.slug ?? '';
}

// author_job_title 後台實際存放的是專家簡介文字（不是職稱），依內容比對而非欄位名稱決定用途
const expertCards: ExpertCard[] = authorColumns
    .filter((item): item is AuthorColumnItem & { author: AuthorProfile } => item.author !== null)
    .map((item) => {
        const rawImage = item.author.author_image?.url ?? null;
        return {
            slug: findSlug(item.author.author_name),
            name: item.author.author_name,
            tags: item.author.author_tag
                ? item.author.author_tag.split(',').map((t) => t.trim()).filter(Boolean)
                : [],
            description: item.author.author_job_title ?? '',
            avatar: rawImage ? (rawImage.startsWith('http') ? rawImage : `${STRAPI_URL}${rawImage}`) : '/expert01.jpg',
            articles: (item.author_article ?? []).map((a) => {
                const link = resolveArticleLink(a.news_category, a.news_article_id, a.news_article_url);
                return { title: a.news_title, href: link.href, external: link.external };
            }),
        };
    });

// 首頁最多顯示 6 位；超過 5 位時排版改成比照 /experts 列表頁的三欄格線卡片，
// 並在右上角加「更多專家」按鈕連到 /experts。5 位（含）以內維持原本靠右一排直向清單的版型。
const displayedCards = expertCards.slice(0, 6);
const isGridMode = expertCards.length > 5;
---
<section data-nav="dark">
    <div id="experts" class:list={[{ gridMode: isGridMode }]}>
        <div class="fadeOverlay"></div>
        <div class="bg">
            <div class="mask"></div>
            <div class="inBox">
                <div class="flex justify-between">
                    <div class="titleBox">
                        <div class="itemTitle">
                            <p>專家觀點</p>
                            <p>EXPERTS</p>
                        </div>
                        {isGridMode && (
                            <div class="more viewMore">
                                <a href="/experts">
                                    <span>更多專家</span>
                                    <div class="arraw">
                                        <img width="28" height="28" src="/arraw-right-03.svg" alt="arraw" />
                                    </div>
                                </a>
                            </div>
                        )}
                    </div>
                    <div class="list">
                        {displayedCards.map((card) => (
                            <div class="item">
                                <div class="imgBox">
                                    <div class="img">
                                        <img width="400" height="400" src={card.avatar} alt={card.name} loading="lazy" />
                                    </div>
                                    <div class="nameBox mobile">
                                        <div class="name">{card.name}</div>
                                        <div class="tag">
                                            {card.tags.map((tag) => (
                                                <a href="#">{tag}</a>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                                <div class="txtBox">
                                    <div class="nameBox pc">
                                        <div class="name">{card.name}</div>
                                        <div class="tag">
                                            {card.tags.map((tag) => (
                                                <a href="#">{tag}</a>
                                            ))}
                                        </div>
                                    </div>
                                    <div class="description">
                                        {card.description}
                                    </div>
                                    <div class="intro">
                                        {card.articles.map((article) => (
                                            <a href={article.href} target={article.external ? '_blank' : undefined} rel={article.external ? 'noopener noreferrer' : undefined}>
                                                <span>{article.title}</span>
                                                <div class="arraw">
                                                    <img width="28" height="28" src="/arraw-right-03.svg" alt="arraw" />
                                                </div>
                                            </a>
                                        ))}
                                    </div>

                                    <div class="more">
                                        <a href={`/experts/${card.slug}`}>
                                            <span>完整介紹與觀點</span>
                                            <div class="arraw">
                                                <img width="28" height="28" src="/arraw-right-03.svg" alt="arraw" />
                                            </div>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    // ===== 專家觀點（#experts）離場漸變 =====
    // 精選出版品區塊頂部一碰到視窗底部（也就是 #experts 底部一進入視窗），#experts 就開始漸漸
    // 變成精選出版品的底色（白色），捲到 #experts 完全離開視窗時全白，有消失接續下去的感覺。
    // 這是跟捲動位置直接掛鉤的連續效果（不是捲過一次就播放完的動畫），所以用 rAF 迴圈每幀
    // 直接算淡色進度，捲動時即時同步、往回捲也會跟著變淡。
    (() => {
        const expertsEl = document.getElementById('experts');
        const overlay = expertsEl?.querySelector<HTMLElement>('.fadeOverlay');
        if (!expertsEl || !overlay) return;

        const SPEED = 6; // 數字越大，變白的速度越快（達到全白所需的捲動距離越短）

        function update() {
            const bottom = expertsEl!.getBoundingClientRect().bottom;
            // 起點不變：#experts 底部（＝ #publications 頂部）一進入視窗（bottom <= innerHeight）就開始算進度，
            // 但只要再捲過 innerHeight / SPEED 的距離就會到全白，不用等 #experts 完全離開視窗。
            const fadeZone = window.innerHeight;
            const fadeDistance = fadeZone / SPEED;
            const progress = Math.min(Math.max((fadeZone - bottom) / fadeDistance, 0), 1);
            // 開根號讓白色在捲動剛開始的階段就拉高不透明度（不是線性等比例增加），
            // 起點/終點不變（0 還是 0、1 還是 1），中間段的白會比原本更快、更濃。
            const opacity = Math.pow(progress, 0.6);
            overlay!.style.opacity = String(opacity);
            requestAnimationFrame(update);
        }
        requestAnimationFrame(update);
    })();
</script>
