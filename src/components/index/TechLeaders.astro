---
import '../../styles/components/index/tech-leaders.css';

interface TechTitanArticle {
    news_title: string;
    news_content_html: string | null;
    news_article_url: string | null;
    news_published_at: string | null;
}

interface TechTitanImage {
    url: string;
}

interface TechTitanMedia {
    media_url: string | null;
}

interface TechTitan {
    tech_titan_name: string;
    tech_titan_job_title: string;
    tech_titan_title: string;
    tech_titan_image: TechTitanImage[] | null;
    tech_titan_articles: TechTitanArticle[] | null;
    tech_titan_media: TechTitanMedia | null;
}

interface ListCard {
    time: string;
    title: string;
    description: string;
    href: string;
}

// news_content_html 是完整文章全文，後台目前沒有獨立的摘要欄位，暫時用截斷全文取代（跟 Hero.astro 的做法一致）
function stripHtml(html: string | null, maxLength: number): string {
    if (!html) return '';
    const text = html.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
    return text.length > maxLength ? `${text.slice(0, maxLength)}…` : text;
}

function formatDate(dateStr: string | null): string {
    if (!dateStr) return '';
    return dateStr.slice(0, 10).replace(/-/g, '/');
}

let techTitan: TechTitan | null = null;
try {
    const res = await fetch(
        `${import.meta.env.STRAPI_URL}/api/index-page?populate[s9_2_tech_titan][populate]=*`,
        { headers: { Authorization: `Bearer ${import.meta.env.STRAPI_API_TOKEN}` } },
    );
    if (res.ok) {
        const json = await res.json();
        // s9_2_tech_titan 是單一 component（不是可放多筆的關聯），回傳就是物件本身，不需要 [0] 取第一筆
        techTitan = json.data?.s9_2_tech_titan ?? null;
    }
} catch {
    techTitan = null;
}

const name = techTitan?.tech_titan_name ?? '黃仁勳';
const jobTitle = techTitan?.tech_titan_job_title ?? 'NVIDIA 共同創辦人暨執行長';
const peoTitle = techTitan?.tech_titan_title ?? '';
const rawImage = techTitan?.tech_titan_image?.[0]?.url ?? null;
const image = rawImage
    ? (rawImage.startsWith('http') ? rawImage : `${import.meta.env.STRAPI_URL}${rawImage}`)
    : '/techLeader01.jpg';
// 上方大圖＋人物介紹的連結來自 tech_titan_media（人物相關的影音報導），跟下面「相關報導」清單的 tech_titan_articles 是分開的欄位
const mediaHref = techTitan?.tech_titan_media?.media_url ?? '#';

// 「相關報導」清單只來自後台 tech_titan_articles 這個欄位，現在已經改成可放多筆的關聯，
// 直接依後台實際筆數渲染，不假設固定 1 or 2 則
const listCards: ListCard[] = (techTitan?.tech_titan_articles ?? []).map((a) => ({
    time: formatDate(a.news_published_at),
    title: a.news_title,
    description: stripHtml(a.news_content_html, 60),
    href: a.news_article_url ?? '#',
}));
---
<section data-nav="dark">
    <div id="leaders">
        <div class="inBox">
            <div class="titleBox">
                <div class="itemTitle">
                    <p>科技大人物</p>
                    <p>TECH LEADERS</p>
                </div>
                <div class="nameBox">
                    <p class="name">{name}</p>
                    <p class="job">{jobTitle}</p>
                </div>
            </div>
            <div class="people">
                <a class="cardLink" href={mediaHref} target="_blank" rel="noopener noreferrer">
                    <div class="img">
                        <img width="1280" height="720" src={image} alt={name} loading="lazy" />
                    </div>
                    <div class="peoTitle">
                        {peoTitle}
                    </div>
                </a>
                {listCards.length > 0 && (
                    <div class="list">
                        <ul>
                            {listCards.map((card) => (
                                <li>
                                    <a href={card.href} target="_blank" rel="noopener noreferrer">
                                        <div class="time">
                                            {card.time}
                                        </div>
                                        <div class="title">
                                            {card.title}
                                        </div>
                                        <div class="description">
                                            {card.description}
                                        </div>
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                )}
            </div>
        </div>
    </div>
</section>
