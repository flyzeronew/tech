---
import { STRAPI_URL, STRAPI_API_TOKEN } from 'astro:env/server';
import '../../styles/components/index/crossover.css';
import { resolveSummary } from '../../lib/articleSummary';
import { resolveArticleImage, type RawNewsImage } from '../../lib/articleImage';
import { cachedFetchJson, CACHE_TTL } from '../../lib/fetchCache';

interface CrossoverArticle {
    id: number;
    news_article_id: string;
    news_title: string;
    news_content_html: string | null;
    news_summary: string | null;
    news_featured_image_url: string | null;
    news_image: RawNewsImage[] | null;
    news_published_at: string | null;
}

interface CrossoverCard {
    date: string;
    title: string;
    description: string;
    image: string;
    href: string;
}

function formatDate(iso: string | null): string {
    if (!iso) return '';
    const d = new Date(iso);
    return `${d.getFullYear()}/${String(d.getMonth() + 1).padStart(2, '0')}/${String(d.getDate()).padStart(2, '0')}`;
}

// news_summary 是後台可選填的摘要欄位，優先用它；沒填才退回用 news_content_html 截斷全文
function stripHtml(html: string | null, maxLength: number): string {
    if (!html) return '';
    const text = html.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
    return text.length > maxLength ? `${text.slice(0, maxLength)}…` : text;
}

// 改成直接撈 news_category=money 的最新 6 篇（不再靠後台 s4_1 手動關聯挑選），
// 一定是 money 分類，全部連到 /money/{id} 內頁
let crossoverItems: CrossoverArticle[] = [];
try {
    const json = await cachedFetchJson<{ data?: CrossoverArticle[] }>(
        `${STRAPI_URL}/api/article-libs?filters[news_category][$eq]=money&sort=news_published_at:desc&pagination[pageSize]=6` +
            `&fields[0]=news_title&fields[1]=news_featured_image_url&fields[2]=news_published_at&fields[3]=news_content_html&fields[4]=news_summary&fields[5]=news_article_id` +
            `&populate[news_image][fields][0]=url`,
        { headers: { Authorization: `Bearer ${STRAPI_API_TOKEN}` } },
        CACHE_TTL.NEWS,
    );
    crossoverItems = json?.data ?? [];
} catch {
    crossoverItems = [];
}

const newsCards: CrossoverCard[] = crossoverItems.map((a) => ({
    date: formatDate(a.news_published_at),
    title: a.news_title,
    description: resolveSummary(a.news_summary, stripHtml(a.news_content_html, 60)),
    image: resolveArticleImage(a.news_image, a.news_featured_image_url, '/news-image-01.jpg'),
    href: `/money/${a.news_article_id}`,
}));
---
<section data-nav="dark">
    <div id="crossover">
        <div class="wipeOverlay"></div>
        <div class="inBox">
            <div class="titleBox">
                <div class="itemTitle animLabel">
                    <p>科技×財經觀點</p>
                    <p>THE CROSSOVER</p>
                </div>
                <div class="more">
                    <a href="/money">
                        <span class="pc">更多財經</span> 
                        <span class="mobile">更多</span>  
                        <div class="arraw">
                            <img width="28" height="28" src="/arraw-right-03.svg" alt="arraw" />
                        </div>
                    </a>
                </div>
            </div>

            <div class="newslist">
                <ul>
                    {newsCards.map((card) => (
                        <li>
                            <a href={card.href}>
                                <div class="date">{card.date}</div>
                                <div class="news">
                                    <div class="img">
                                        <img width="96" height="54" src={card.image} alt="arraw" loading="lazy" />
                                    </div>
                                    <div class="titleBox">
                                        <div class="time">{card.date}</div>
                                        <div class="title">{card.title}</div>
                                        <div class="description">{card.description}</div>
                                    </div>
                                </div>
                                <div class="arraw">
                                    <img width="24" height="24 " src="/arraw-right-03.svg" alt="arraw" />
                                </div>
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        </div>
    </div>
</section>

<script>
    // ===== 科技×財經觀點（#crossover）進場動畫 =====
    // 1. 白色遮罩往上收合，露出底下已經完成排版的藍色區塊
    // 2. 遮罩收合得差不多後，標題套用跟頁首第一卡相同的 .animLabel 掃描動畫
    // 3. 新聞清單由上而下逐項淡入上移
    // 跟 #spotlight 用同一套規則：用 requestAnimationFrame 每幀輪詢，而不是監聽 scroll 事件
    // （導覽列用 JS 自訂緩動捲動，純程式觸發的捲動 scroll 事件不一定每幀都確實觸發，每幀主動量測才準確）。
    // 不能單純判斷「top 跨越 0」：導覽列點擊的自訂緩動捲動是精準地「趨近」top = 0 這個目標並停在那裡，
    // 不會真的越過 0 到另一側，這種情況永遠不會發生正負交叉。改成偵測 top 第一次進入「接近 0（±2px 內）」
    // 這個小範圍，同時保留正負交叉判斷避免大幅捲動一次跳過這個小範圍的極端情況漏判。
    // 不管是由上往下捲、由下往上捲，還是點導覽列用程式捲動過來，都只在區塊頂部真正切齊 viewport 頂端時觸發。
    // 置頂後停留 0.1 秒再開始播放動畫，讓使用者先看到區塊到位，而不是一到頂就馬上動。
    // 頁面載入/重新整理當下如果就已經停留在區塊頂部（例如瀏覽器還原了捲動位置），直接觸發一次，
    // 不用等使用者先捲遠、再捲回來才播放。
    const crossoverEl = document.getElementById('crossover');
    if (crossoverEl) {
        const NEAR = 2;
        let triggered = false;
        // 直接以錨點連結進站（例如從其他頁面點導覽列連回 /#crossover，見 Header.astro 的跨頁導回
        // 邏輯）時，一到頁面就已經在區塊頂端，不該播放設計給「使用者往下捲動發現」情境的進場動畫，
        // 改成直接跳到動畫播完的最終狀態（見 crossover.css 的 .no-anim 規則），跟 #spotlight 同一套處理方式。
        const skipAnim = location.hash === '#crossover';
        const trigger = () => {
            triggered = true;
            crossoverEl.classList.add('is-visible');
            if (skipAnim) {
                crossoverEl.classList.add('content-visible', 'no-anim');
                return;
            }
            window.setTimeout(() => {
                crossoverEl.classList.add('content-visible');
            }, 550);
        };
        if (Math.abs(crossoverEl.getBoundingClientRect().top) <= NEAR) {
            trigger();
        } else {
            let prevTop = crossoverEl.getBoundingClientRect().top;
            const poll = () => {
                if (triggered) return;
                const top = crossoverEl.getBoundingClientRect().top;
                const wasFar = Math.abs(prevTop) > NEAR;
                const nowNear = Math.abs(top) <= NEAR;
                const signFlipped = (prevTop > NEAR && top < -NEAR) || (prevTop < -NEAR && top > NEAR);
                if (wasFar && (nowNear || signFlipped)) {
                    trigger();
                    return;
                }
                prevTop = top;
                requestAnimationFrame(poll);
            };
            requestAnimationFrame(poll);
        }
    }
</script>
