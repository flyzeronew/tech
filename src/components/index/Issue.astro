---
import '../../styles/components/index/issue.css';

// 格子大小依 .bg 16:9 的比例換算成正方形（9/64 = 14.0625%），跟 issue.css 的 wipeRow／bgImage 對齊
// 垂直線用「半格」偏移（k+0.5），這樣正中間會是一整格、而不是一條線，才能跟 .bgImage 置中對齊
const gridCellPercent = (100 * 9) / 64;
const horizontalLines = [0, 25, 50, 75, 100];
const verticalLines = [];
for (let k = -4; k <= 3; k++) {
    const pos = 50 + (k + 0.5) * gridCellPercent;
    if (pos >= -0.01 && pos <= 100.01) verticalLines.push(Math.min(100, Math.max(0, pos)));
}
const gridLineStagger = 0.09;
---
<section>
    <div id="issue">
        <div class="bg">
            <div class="wipeStage">
                <span class="wipeRow"></span>
                <span class="wipeRow"></span>
                <span class="wipeRow"></span>
                <span class="wipeRow"></span>
            </div>
            <div class="gridLines">
                {horizontalLines.map((pos, i) => (
                    <span
                        class="gridLine gridLine--h"
                        style={`top:${pos}%; transition-delay:${(0.9 + i * gridLineStagger).toFixed(2)}s`}
                    ></span>
                ))}
                {verticalLines.map((pos, i) => (
                    <span
                        class="gridLine gridLine--v"
                        style={`left:${pos}%; transition-delay:${(0.9 + (horizontalLines.length + i) * gridLineStagger).toFixed(2)}s`}
                    ></span>
                ))}
            </div>
            <div class="bgImage"></div>
            <div class="inBox">
                <div class="txtBox">
                    <div class="itemTitle">
                        <p>獨家專題</p>
                        <p>ONLY FROM THE TVBS TECH</p>
                    </div>
                    <div class="title">
                        <p>亞利桑那觀察 ———</p>
                        <p class="big">矽沙漠崛起</p>
                        <p>台灣的晶片，正在重塑一座美國沙漠城市。</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="issueList">
            <div class="inBox">
                <p class="description">
                    台積電落腳沙漠，不只帶來一座晶圓廠，而是帶動半導體供應鏈、造鎮開發、人才培育、台灣美食、航太科技與直航航班。
                    TVBS 新聞網深度策展，帶你看懂一家台灣企業如何改變一座美國城市的命運。
                </p>

                <div class="list">
                    <div class="col">
                        <div class="item">
                            <div class="tag">
                                <a href="#">Podcast</a>
                            </div>
                            <div class="title">
                                【2100TVBS看世界】台積電加碼3.3兆投資美國 還在亞利桑那蓋研發中心 川普暫停對烏克蘭所有軍援
                            </div>
                            <div class="img">
                                <div class="statusIcon linkIcon"></div>
                                <img width="300" height="300" src="/issue-image-01.jpg" alt="img" loading="lazy" />
                            </div>
                        </div>
                        <div class="item">
                            <div class="tag">
                                <a href="#">專題報導</a>
                            </div>
                            <div class="title">
                                150 億美元交通藍圖背後：亞利桑那正打造下一個 30 年的產業走廊
                            </div>
                            <div class="img">
                                <div class="statusIcon linkIcon"></div>
                                <img width="300" height="169" src="/issue-image-02.jpg" alt="img" loading="lazy" />
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="item">
                            <div class="tag">
                                <a href="#">專題報導</a>
                            </div>
                            <div class="title">
                                雙城故事：當台北遇上鳳凰城　AI 時代最重要的新科技走廊正形成
                            </div>
                            <div class="img">
                                <div class="statusIcon linkIcon"></div>
                                <img width="300" height="169" src="/issue-image-03.jpg" alt="img" loading="lazy" />
                            </div>
                        </div>
                        <div class="item">
                            <div class="tag">
                                <a href="#">專題報導</a>
                            </div>
                            <div class="title">
                                台積電帶動「台灣嬰兒潮」 鳳凰城市長：已誕生 500 個寶寶
                            </div>
                            <div class="img">
                                <div class="statusIcon linkIcon"></div>
                                <img width="300" height="169" src="/issue-image-04.jpg" alt="img" loading="lazy" />
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="item">
                            <div class="tag">
                                <a href="#">影片</a>
                            </div>
                            <div class="title">
                                【黃仁勳專訪】黃仁勳:別怕AI搶飯碗! 從汽車發明看AI社會共存 親自使用AI縮小科技落差 黃仁勳再談能源重要性…
                            </div>
                            <div class="img">
                                <div class="statusIcon linkIcon"></div>
                                <img width="300" height="169" src="/issue-image-05.jpg" alt="img" loading="lazy" />
                            </div>
                        </div>
                        <div class="item">
                            <div class="tag">
                                <a href="#">專題報導</a>
                            </div>
                            <div class="title">
                                150 億美元交通藍圖背後：亞利桑那正打造下一個 30 年的產業走廊
                            </div>
                            <div class="img">
                                <div class="statusIcon linkIcon"></div>
