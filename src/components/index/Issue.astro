                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    // ===== 獨家專題（#issue）進場動畫 =====
    // 白畫面 → 階梯狀色塊由右往左收合成黑 → 格線背景 + 縮小的圖出現在正中間 → 圖放大到滿版、文字淡入
    // rootMargin 下緣收到 -100%，讓判定範圍只剩「viewport 最頂端那一條線」，
    // 區塊頂部要真正捲到頁面最上緣（置頂）才會觸發，而不是提早在還沒到頂時就播放。
    // 觸發後就 unobserve，動畫只播放一次，之後不管怎麼捲動都不會再重播。
    const issueEl = document.getElementById('issue');
    if (issueEl) {
        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    issueEl.classList.add('is-visible');
                    observer.unobserve(issueEl);
                }
            });
        }, { threshold: 0, rootMargin: '0px 0px -100% 0px' });
        observer.observe(issueEl);
    }
</script>
