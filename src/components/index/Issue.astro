---
import { STRAPI_URL, STRAPI_API_TOKEN } from 'astro:env/server';
import '../../styles/components/index/issue.css';
import { resolveArticleLink } from '../../lib/articleLink';
import { resolveArticleImage, type RawNewsImage } from '../../lib/articleImage';
import { cachedFetchJson, CACHE_TTL } from '../../lib/fetchCache';

// 垂直格線位置改用 CSS 變數 --issue-cell（正方形格子寬度佔 .bg 寬度的比例）算，不再是寫死的固定百分比：
// --issue-cell 會依 .bg 當下的 16:9／9:16 比例在 issue.css 切換，格線與 .bgImage 縮放起點就能自動對齊新比例，不用另外重算。
// 垂直線用「半格」偏移（k+0.5），這樣正中間會是一整格、而不是一條線，才能跟 .bgImage 置中對齊；
// 超出 0~100% 範圍的格線交給 .bg 的 overflow:hidden 裁掉即可，兩種比例都用同一組 8 條線就好。
const horizontalLines = [0, 25, 50, 75, 100];
const verticalLineOffsets = [-4, -3, -2, -1, 0, 1, 2, 3].map((k) => k + 0.5);
const gridLineStagger = 0.09;

interface IssueArticle {
    news_title: string;
    news_category: string | null;
    news_article_id: string;
    news_article_url: string | null;
    news_featured_image_url: string | null;
    news_image: RawNewsImage[] | null;
    news_youtube_id: string | null;
}

interface IssueCard {
    tag: string;
    title: string;
    href: string;
    external: boolean;
    image: string;
    hasVideo: boolean;
}

// 後台部分文章的 news_youtube_id 存的是字串 "null"（不是真正的 null），
// 判斷有沒有影片時要一併排除，不然會誤判成有 YouTube 影片可嵌入（跟 articleDetail.ts 同一套判斷）
function hasYoutubeVideo(id: string | null): boolean {
    return Boolean(id) && id !== 'null';
}

// 下面 6 則清單抓後台 article_source = issue 的文章（「亞利桑那觀察」系列），依發布時間新到舊取最新 6 篇
let issueArticles: IssueArticle[] = [];
try {
    const json = await cachedFetchJson<{ data?: IssueArticle[] }>(
        `${STRAPI_URL}/api/article-libs?filters[article_source][$eq]=issue&sort=news_published_at:desc&pagination[pageSize]=6` +
            `&fields[0]=news_title&fields[1]=news_category&fields[2]=news_article_id&fields[3]=news_article_url&fields[4]=news_featured_image_url&fields[5]=news_youtube_id` +
            `&populate[news_image][fields][0]=url`,
        { headers: { Authorization: `Bearer ${STRAPI_API_TOKEN}` } },
        CACHE_TTL.NEWS,
    );
    issueArticles = json?.data ?? [];
} catch {
    issueArticles = [];
}

const issueCards: IssueCard[] = issueArticles.map((a) => {
    const link = resolveArticleLink(a.news_category, a.news_article_id, a.news_article_url);
    return {
        tag: a.news_category ?? '',
        title: a.news_title,
        href: link.href,
        external: link.external,
        image: resolveArticleImage(a.news_image, a.news_featured_image_url, '/issue-image-01.jpg'),
        hasVideo: hasYoutubeVideo(a.news_youtube_id),
    };
});

// 版面固定 3 欄 x 2 則，依原始順序（新到舊）依序分配進三欄，跟原本寫死的排法一致
const issueColumns = [issueCards.slice(0, 2), issueCards.slice(2, 4), issueCards.slice(4, 6)];
---
<section>
    <div id="spotlight" data-nav="dark">
        <div class="bg">
            <div class="wipeStage">
                <span class="wipeRow"></span>
                <span class="wipeRow"></span>
                <span class="wipeRow"></span>
                <span class="wipeRow"></span>
            </div>
            <div class="gridLines">
                {horizontalLines.map((pos, i) => (
                    <span
                        class="gridLine gridLine--h"
                        style={`top:${pos}%; transition-delay:${(0.9 + i * gridLineStagger).toFixed(2)}s`}
                    ></span>
                ))}
                {verticalLineOffsets.map((offset, i) => (
                    <span
                        class="gridLine gridLine--v"
                        style={`left: calc(50% + ${offset} * var(--issue-cell) * 100%); transition-delay:${(0.9 + (horizontalLines.length + i) * gridLineStagger).toFixed(2)}s`}
                    ></span>
                ))}
            </div>
            <div class="bgImage"></div>
            <div class="inBox">
                <div class="txtBox">
                    <div class="itemTitle">
                        <p>獨家專題</p>
                        <p>TVBS SPOTLIGHT</p>
                    </div>
                    <div class="title">
                        <p>亞利桑那觀察 ———</p>
                        <p class="big">矽沙漠崛起</p>
                        <p>台灣的晶片，正在重塑一座美國沙漠城市。</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="issueList">
            <div class="inBox">
                <div class="descRow">
                    <p class="description">
                        台積電落腳沙漠，不只帶來一座晶圓廠，而是帶動半導體供應鏈、造鎮開發、人才競爭與交通建設，甚至牽動醫療、AI產業的下一波升級。
                        TVBS新聞網深度策展，帶你看懂一家台灣企業如何改變一座美國城市的命運。
                    </p>
                    <div class="more">
                        <a href="https://news.tvbs.com.tw/topics/money/1583" target="_blank">
                            <span class="full">更多專題報導</span>
                            <span class="short">更多</span>
                            <div class="arraw">
                                <img width="28" height="28" src="/arraw-right-03.svg" alt="arraw" />
                            </div>
                        </a>
                    </div>
                </div>

                <div class="list">
                    {issueColumns.map((col, colIndex) => (
                        <div class="col">
                            {col.map((card, itemIndex) => {
                                const isSquare = colIndex === 0 && itemIndex === 0;
                                return (
                                    <div class="item">
                                        <a
                                            class="cardLink"
                                            href={card.href}
                                            target={card.external ? '_blank' : undefined}
                                            rel={card.external ? 'noopener noreferrer' : undefined}
                                        >
                                            <div class="tag">
                                                <span>{card.tag}</span>
                                            </div>
                                            <div class="title">
                                                {card.title}
                                            </div>
                                            <div class:list={['img', { 'img--square': isSquare }]}>
                                                {card.hasVideo ? (
                                                    <div class="statusIcon playIcon"></div>
                                                ) : (
                                                    <div class="statusIcon linkIcon"></div>
                                                )}
                                                <img
                                                    width="300"
                                                    height={isSquare ? 300 : 169}
                                                    src={card.image}
                                                    alt={card.title}
                                                    loading="lazy"
                                                />
                                            </div>
                                        </a>
                                    </div>
                                );
                            })}
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    // ===== 獨家專題（#spotlight）進場動畫 =====
    // 白畫面 → 階梯狀色塊由右往左收合成黑 → 格線背景 + 縮小的圖出現在正中間 → 圖放大到滿版、文字淡入
    // 用 requestAnimationFrame 每幀輪詢「區塊頂部與 viewport 頂端切齊」這一刻，而不是監聽 scroll 事件：
    // 導覽列點擊是用 JS rAF 迴圈自訂緩動捲動（見 Header.astro），搭配全域 scroll-behavior: smooth，
    // 純程式觸發的捲動在部分瀏覽器下 scroll 事件不一定會每幀都確實觸發，改成每幀主動量測最準確。
    // 單純判斷 top <= 0 在由下往上捲（從區塊下方進場）時會太早觸發——區塊只要露出一點點、
    // top 就已經是負值了，並非真正到頂那一刻。
    // 也不能單純判斷「top 跨越 0」（正變負或負變正）：導覽列點擊的自訂緩動捲動是精準地「趨近」
    // top = 0 這個目標並停在那裡，不會真的越過 0 到另一側，這種情況永遠不會發生正負交叉。
    // 改成偵測 top 第一次進入「接近 0（±2px 內）」這個小範圍，兩種情況都能正確涵蓋；
    // 同時保留正負交叉判斷，避免捲動幅度較大、一次就跳過這個小範圍的極端情況漏判。
    // 置頂後停留 0.1 秒再開始播放動畫，讓使用者先看到區塊到位，而不是一到頂就馬上動。
    // 觸發後就停止輪詢，動畫只播放一次，之後不管怎麼捲動都不會再重播。
    // 頁面載入/重新整理當下如果就已經停留在區塊頂部（例如瀏覽器還原了捲動位置），直接觸發一次，
    // 不用等使用者先捲遠、再捲回來才播放。
    const issueEl = document.getElementById('spotlight');
    if (issueEl) {
        const NEAR = 2;
        let triggered = false;
        // 直接以錨點連結進站（例如重新整理時網址列本來就帶 #spotlight，或從其他頁面點導覽列連回
        // /#spotlight，見 Header.astro 的跨頁導回邏輯）時，一到頁面就已經在區塊頂端，不該播放這段
        // 設計給「使用者往下捲動發現」情境的進場動畫——不然會有好幾秒畫面整個是白的（見上方
        // #spotlight .bg 的初始 background-color: #fff），看起來像沒捲到定位。這種情況直接跳到
        // 動畫播完的最終狀態（見 issue.css 的 .no-anim 規則）。
        const skipAnim = location.hash === '#spotlight';
        const trigger = () => {
            triggered = true;
            if (skipAnim) {
                issueEl.classList.add('is-visible', 'no-anim');
                return;
            }
            window.setTimeout(() => {
                issueEl.classList.add('is-visible');
            }, 50);
        };
        if (Math.abs(issueEl.getBoundingClientRect().top) <= NEAR) {
            trigger();
        } else {
            let prevTop = issueEl.getBoundingClientRect().top;
            const poll = () => {
                if (triggered) return;
                const top = issueEl.getBoundingClientRect().top;
                const wasFar = Math.abs(prevTop) > NEAR;
                const nowNear = Math.abs(top) <= NEAR;
                const signFlipped = (prevTop > NEAR && top < -NEAR) || (prevTop < -NEAR && top > NEAR);
                if (wasFar && (nowNear || signFlipped)) {
                    trigger();
                    return;
                }
                prevTop = top;
                requestAnimationFrame(poll);
            };
            requestAnimationFrame(poll);
        }
    }
</script>

<script>
    // ===== 獨家專題（#spotlight）768～1023px：JS 真．瀑布流兩欄；768px 以下改回單欄，不需要分欄 =====
    // 純 CSS Grid／多欄排版在「兩欄各放一半項目」時無法避免高度不一致造成的空隙（Grid 同列會被較高的那項卡住，
    // 多欄排版順序又會變成「左欄先填滿」而非交錯）。這裡改用貪婪演算法：依原始順序依序把每張卡片
    // 塞進「目前比較矮」的那一欄，卡片間就不會再多出空白，同時仍盡量保留接近原始的閱讀順序。
    // 量測高度需要在卡片還是正常版面（未搬移）時進行，所以先量測、算好分欄結果，才真正搬移 DOM。
    // 切回 1024px 以上時要能還原成原本三欄的 DOM 結構，所以先記住每張卡片原本的位置。
    const issueList = document.querySelector<HTMLElement>('#spotlight .issueList .list');
    if (issueList) {
        const items = Array.from(issueList.querySelectorAll<HTMLElement>('.item'));
        const originalSlots = items.map((item) => ({
            item,
            parent: item.parentElement as HTMLElement,
            nextSibling: item.nextElementSibling,
        }));

        const masonryQuery = window.matchMedia('(max-width: 1023px) and (min-width: 768px)');
        let masonryCols: HTMLElement[] | null = null;

        function restoreDesktop() {
            if (!masonryCols) return;
            originalSlots.forEach(({ item, parent, nextSibling }) => {
                parent.insertBefore(item, nextSibling);
            });
            masonryCols.forEach((col) => col.remove());
            masonryCols = null;
            issueList!.classList.remove('is-masonry');
        }

        function buildMasonry() {
            if (masonryCols) return;
            const heights = items.map((item) => item.getBoundingClientRect().height);
            const colA = document.createElement('div');
            const colB = document.createElement('div');
            colA.className = 'masonryCol';
            colB.className = 'masonryCol';
            let heightA = 0;
            let heightB = 0;
            items.forEach((item, i) => {
                const h = heights[i];
                if (heightA <= heightB) {
                    colA.appendChild(item);
                    heightA += h;
                } else {
                    colB.appendChild(item);
                    heightB += h;
                }
            });
            issueList!.appendChild(colA);
            issueList!.appendChild(colB);
            masonryCols = [colA, colB];
            issueList!.classList.add('is-masonry');
        }

        // resize 事件在手機瀏覽器很容易因為網址列顯示/隱藏而觸發（寬度沒變、只有高度變），
        // 這裡只在「寬度真的變了」或「還沒建立過」時才重新分欄，避免每次都重搬 DOM 造成閃爍
        let lastWidth = window.innerWidth;
        function sync() {
            const widthChanged = window.innerWidth !== lastWidth;
            lastWidth = window.innerWidth;
            if (masonryQuery.matches) {
                if (!masonryCols || widthChanged) {
                    restoreDesktop();
                    buildMasonry();
                }
            } else if (masonryCols) {
                restoreDesktop();
            }
        }

        sync();
        masonryQuery.addEventListener('change', sync);
        window.addEventListener('resize', sync);
    }
</script>
