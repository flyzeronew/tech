---
import '../../styles/components/index/partners.css';
---
<section data-nav="light">
    <div id="partners">
        <div class="inBox">
            <div class="bigTitleBox">
                <div class="title">
                    洞察<span>全球事件</span><br>
                    佈局<span>未來</span>
                </div>
                <div class="description">
                    同步國際媒體的即時資訊，深耕高階與深度的內容，<br>
                    深入淺出，在變局中引領你掌握未來。
                </div>
            </div>

            <div class="form">
                <div class="list">
                    <ul>
                        <li>
                            <div class="titleBox">
                                <div class="itemTitle">
                                    <p>國際媒體夥伴</p>
                                    <p>MEDIA PARTNERS</p>
                                </div>
                            </div>
                            <div class="logos">
                                <a href="#">
                                    <img width="282" height="48" src="/logo_Arizona CommerceAuthority.png" alt="partner" loading="lazy" />
                                </a>
                                <a href="#">
                                    <img width="282" height="48" src="/logo_AXIOSPhoenix.png" alt="partner" loading="lazy" />
                                </a>
                                <a href="#">
                                    <img width="282" height="48" src="/logo_PhoenixNewTimes.png" alt="partner" loading="lazy" />
                                </a>
                                <a href="#">
                                    <img width="282" height="48" src="/logo_ArizonaDailyStar.png" alt="partner" loading="lazy" />
                                </a>
                                <a href="#">
                                    <img width="282" height="48" src="/logo_TheArizonaRepublic.png" alt="partner" loading="lazy" />
                                </a>
                            </div>
                        </li>
                        <li>
                            <div class="titleBox">
                                <div class="itemTitle">
                                    <p>與我們合作</p>
                                    <p>COLLABORATION</p>
                                </div>
                            </div>
                            <div class="data">
                                <form class="collabForm">
                                    <div class="row">
                                        <div class="field">
                                            <label for="collabName">聯絡人</label>
                                            <input type="text" id="collabName" name="collabName" placeholder="聯絡人姓名" />
                                        </div>
                                        <div class="field">
                                            <label for="collabTitle">職稱</label>
                                            <input type="text" id="collabTitle" name="collabTitle" placeholder="職稱或稱謂" />
                                        </div>
                                    </div>
                                    <div class="field">
                                        <label for="collabEmail">Email</label>
                                        <input type="email" id="collabEmail" name="collabEmail" placeholder="xxx@company.com" />
                                    </div>
                                    <div class="field">
                                        <label for="collabContent">合作內容</label>
                                        <input type="text" id="collabContent" name="collabContent" placeholder="請簡述合作內容" />
                                    </div>
                                    <div class="more">
                                        <button type="submit">
                                            <span>送出</span>
                                            <div class="arraw">
                                                <img width="28" height="28" src="/arraw-right-02.svg" alt="arraw" />
                                            </div>
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </li>
                        <li>
                            <div class="titleBox">
                                <div class="itemTitle">
                                    <p>追蹤我們</p>
                                    <p>FOLLOW US</p>
                                </div>
                            </div>
                            <div class="follow">
                                <a href="#" class="followItem">
                                    <img width="24" height="24" src="/ic-linkedin.svg" alt="LinkedIn" />
                                    <span>追蹤 LinkedIn</span>
                                    <div class="arraw">
                                        <img width="28" height="28" src="/arraw-right-02.svg" alt="arraw" />
                                    </div>
                                </a>
                                <a href="#" class="followItem">
                                    <img width="24" height="24" src="/ic-youtube.svg" alt="YouTube" />
                                    <span>訂閱 YouTube</span>
                                    <div class="arraw">
                                        <img width="28" height="28" src="/arraw-right-02.svg" alt="arraw" />
                                    </div>
                                </a>
                                <a href="#" class="followItem">
                                    <img width="24" height="24" src="/ic-podcast.svg" alt="Podcast" />
                                    <span>追蹤 Podcast</span>
                                    <div class="arraw">
                                        <img width="28" height="28" src="/arraw-right-02.svg" alt="arraw" />
                                    </div>
                                </a>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>
