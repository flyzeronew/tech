---
import { STRAPI_URL, STRAPI_API_TOKEN } from 'astro:env/server';
import '../../styles/components/index/partners.css';
import { cachedFetchJson, CACHE_TTL } from '../../lib/fetchCache';

interface FooterPartner {
    link_name: string;
    link_url: string | null;
    link_icon: { url: string }[] | null;
}

const DEFAULT_PARTNER_LOGO = '/logo_AXIOSPhoenix.png';

let footerPartners: FooterPartner[] = [];
try {
    const json = await cachedFetchJson<{ data?: { media_partners?: FooterPartner[] } }>(
        `${STRAPI_URL}/api/footer?populate[media_partners][populate][link_icon]=true`,
        { headers: { Authorization: `Bearer ${STRAPI_API_TOKEN}` } },
        CACHE_TTL.NAV,
    );
    footerPartners = json?.data?.media_partners ?? [];
} catch {
    footerPartners = [];
}

const partnerLogos = footerPartners.map((p) => {
    const rawIcon = p.link_icon?.[0]?.url;
    const icon = rawIcon
        ? (rawIcon.startsWith('http') ? rawIcon : `${STRAPI_URL}${rawIcon}`)
        : DEFAULT_PARTNER_LOGO;
    return {
        name: p.link_name,
        href: p.link_url ?? '#',
        icon,
    };
});
---
<section data-nav="light">
    <div id="collaboration">
        <div class="inBox">
            <div class="bigTitleBox">
                <div class="title">
                    洞察<span>全球事件</span><br>
                    佈局<span>未來</span>
                </div>
                <div class="description">
                    同步國際媒體的即時資訊，深耕高階與深度的內容，<br>
                    深入淺出，在變局中引領你掌握未來。
                </div>
            </div>

            <div class="form">
                <div class="list">
                    <ul>
                        <li>
                            <div class="titleBox">
                                <div class="itemTitle">
                                    <p>國際媒體夥伴</p>
                                    <p>MEDIA PARTNERS</p>
                                </div>
                            </div>
                            <div class="logos">
                                {partnerLogos.map((partner) => (
                                    <a href={partner.href} target="_blank" rel="noopener noreferrer">
                                        <img width="282" height="48" src={partner.icon} alt={partner.name} loading="lazy" />
                                    </a>
                                ))}
                            </div>
                        </li>
                        <li>
                            <div class="titleBox">
                                <div class="itemTitle">
                                    <p>與我們合作</p>
                                    <p>COLLABORATION</p>
                                </div>
                            </div>
                            <div class="data">
                                <form class="collabForm">
                                    <div class="row">
                                        <div class="field">
                                            <label for="collabName">聯絡人</label>
                                            <input type="text" id="collabName" name="collabName" placeholder="聯絡人姓名" />
                                        </div>
                                        <div class="field">
                                            <label for="collabTitle">職稱</label>
                                            <input type="text" id="collabTitle" name="collabTitle" placeholder="職稱或稱謂" />
                                        </div>
                                    </div>
                                    <div class="field">
                                        <label for="collabEmail">Email</label>
                                        <input type="email" id="collabEmail" name="collabEmail" placeholder="xxx@company.com" />
                                    </div>
                                    <div class="field">
                                        <label for="collabContent">合作內容</label>
                                        <input type="text" id="collabContent" name="collabContent" placeholder="請簡述合作內容" />
                                    </div>
                                    <div class="more">
                                        <button type="submit">
                                            <span>送出</span>
                                            <div class="arraw">
                                                <img width="28" height="28" src="/arraw-right-02.svg" alt="arraw" />
                                            </div>
                                        </button>
                                    </div>
                                    <p class="formMsg" role="status"></p>
                                </form>
                            </div>
                        </li>
                        <li>
                            <div class="titleBox">
                                <div class="itemTitle">
                                    <p>追蹤我們</p>
                                    <p>FOLLOW US</p>
                                </div>
                            </div>
                            <div class="follow">
                                <a href="https://www.linkedin.com/showcase/tvbs-tech/" target="_blank" rel="noopener noreferrer" class="followItem">
                                    <img width="24" height="24" src="/ic-linkedin.svg" alt="LinkedIn" />
                                    <span>追蹤 LinkedIn</span>
                                    <div class="arraw">
                                        <img width="28" height="28" src="/arraw-right-02.svg" alt="arraw" />
                                    </div>
                                </a>
                                <a href="https://www.youtube.com/watch?v=JPmb6UzzpBo&list=PLmVlUjKuEG7SikBn4h8gZKuN0gn_yxetj" target="_blank" rel="noopener noreferrer" class="followItem">
                                    <img width="24" height="24" src="/ic-youtube.svg" alt="YouTube" />
                                    <span>訂閱 YouTube</span>
                                    <div class="arraw">
                                        <img width="28" height="28" src="/arraw-right-02.svg" alt="arraw" />
                                    </div>
                                </a>
                                <a href="https://podcasts.apple.com/tw/podcast/%E6%96%B0%E8%81%9E%E5%B9%95%E5%BE%8C/id1737083276" target="_blank" rel="noopener noreferrer" class="followItem">
                                    <img width="24" height="24" src="/ic-podcast.svg" alt="Podcast" />
                                    <span>追蹤 Podcast</span>
                                    <div class="arraw">
                                        <img width="28" height="28" src="/arraw-right-02.svg" alt="arraw" />
                                    </div>
                                </a>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    // ===== 與我們合作（#collaboration .collabForm）：送出到 Google Apps Script Web App =====
    // 後端沒有自己的 API，改用獨立的 Google Apps Script 專案當輕量後端（不綁定 Sheet，不存檔）：
    // 表單 POST 過去後，Apps Script 直接寄信通知蔣翠芳副理（monica@tvbs.com.tw）。
    // 部署步驟＋完整的 Apps Script 程式碼見 GOOGLE_APPS_SCRIPT.md，部署後把下面這個網址換成實際拿到的 Web App URL。
    const COLLAB_FORM_ENDPOINT = 'https://script.google.com/macros/s/AKfycbyyxOEmcBRaiREKI1GM2VoEGrlR9Uwij642eHcD2_Sy3iaDc1Quhu8YlYbTXwHniCw/exec';

    const collabForm = document.querySelector<HTMLFormElement>('#collaboration .collabForm');
    const formMsg = document.querySelector<HTMLElement>('#collaboration .formMsg');

    collabForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const submitBtn = collabForm.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (submitBtn) submitBtn.disabled = true;
        if (formMsg) {
            formMsg.textContent = '送出中…';
            formMsg.classList.remove('is-error');
        }

        try {
            // Apps Script Web App 對跨網域 POST 的 CORS 支援不穩定，用 no-cors 送出可以避開預檢請求，
            // 但代價是讀不到回應內容/狀態碼——這裡採「只要 fetch 沒有丟出網路層錯誤就視為送出成功」的做法，
            // 這也是靜態網站串 Apps Script 常見的處理方式。
            await fetch(COLLAB_FORM_ENDPOINT, {
                method: 'POST',
                mode: 'no-cors',
                body: new FormData(collabForm),
            });
            if (formMsg) formMsg.textContent = '送出成功，感謝您的洽詢！';
            collabForm.reset();
        } catch {
            if (formMsg) {
                formMsg.textContent = '送出失敗，請稍後再試一次。';
                formMsg.classList.add('is-error');
            }
        } finally {
            if (submitBtn) submitBtn.disabled = false;
        }
    });
</script>
