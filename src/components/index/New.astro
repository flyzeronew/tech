---
import '../../styles/components/index/new.css';
---
<section>
    <div id="new">
        <div class="inBox">
            <div class="flex">
                <div class="titleBox">
                    <div class="itemTitle">
                        <p>最新科技情報</p>
                        <p>TECH SIGNALS</p>
                    </div>
                    <div class="title">
                        讀懂<span>趨勢</span><br>
                        再<span>行動</span>
                    </div>
                </div>
                <div class="list">
                    <div class="item">
                        <div class="img">
                            <img width="600" height="342 " src="/news-image-07.jpg" alt="img" />
                        </div>
                        <div class="txtBox">
                            <div class="title">
                                三星全球導入 ChatGPT 與 Codex　OpenAI 拿下最大企業部署案之一
                            </div>
                            <div class="description">
                                企業級 AI 落地再下一城，OpenAI 在大型製造業者的滲透加速。
                            </div>
                            <div class="tag">
                                <a href="#">AI</a>
                                <a href="#">半導體</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
