---
import { STRAPI_URL, STRAPI_API_TOKEN } from 'astro:env/server';
import '../../styles/components/index/new.css';
import { resolveArticleLink } from '../../lib/articleLink';
import { resolveSummary } from '../../lib/articleSummary';
import { resolveArticleImage, type RawNewsImage } from '../../lib/articleImage';
import { cachedFetchJson, CACHE_TTL } from '../../lib/fetchCache';

interface ArticleTag {
    name: string;
}

interface ArticleData {
    id: number;
    news_article_id: string;
    news_title: string;
    news_category: string | null;
    news_tag: ArticleTag[] | null;
    news_content_html: string | null;
    news_summary: string | null;
    news_featured_image_url: string | null;
    news_image: RawNewsImage[] | null;
    news_article_url: string | null;
    news_youtube_id: string | null;
}

interface TechZoneEntry {
    tech_title: string;
    articles: ArticleData[];
}

interface NewsCard {
    bigTitle: string;
    image: string;
    title: string;
    description: string;
    tags: string[];
    href: string;
    external: boolean;
    hasVideo: boolean;
}

// news_summary 是後台可選填的摘要欄位，優先用它；沒填才退回用 news_content_html 截斷全文
function stripHtml(html: string | null, maxLength: number): string {
    if (!html) return '';
    const text = html.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
    return text.length > maxLength ? `${text.slice(0, maxLength)}…` : text;
}

// 大標題原本是手動排版成兩行（讀懂趨勢／再行動），現在文字改從後台拉、長度不固定，
// 改成每 4 個字自動換行，維持原本的大字級排版節奏
function wrapEvery4Chars(text: string): string {
    const chars = Array.from(text);
    const lines: string[] = [];
    for (let i = 0; i < chars.length; i += 4) {
        lines.push(chars.slice(i, i + 4).join(''));
    }
    return lines.join('<br>');
}

// 「最新科技情報／TECH SIGNALS」這組小標題前台固定寫死，不從後台拉——
// s1_tech_zone 是 3 筆，各自帶自己的 tech_title（滾動卡片上方的大標題文字）+ 一組文章（目前各 3 篇，不一定固定 3）。
// 前台把每一筆底下的文章攤平成依序的卡片清單，每張卡片各自標記自己所屬的 tech_title；
// 捲動時同一筆底下的文章共用同一個大標題，捲過該筆最後一篇才會自然換到下一筆的大標題，
// 不需要另外寫兩層捲動邏輯。
let techZoneEntries: TechZoneEntry[] = [];
try {
    const json = await cachedFetchJson<{ data?: { s1_tech_zone?: TechZoneEntry[] } }>(
        `${STRAPI_URL}/api/index-page?populate[s1_tech_zone][populate][articles][populate][news_image][fields][0]=url`,
        { headers: { Authorization: `Bearer ${STRAPI_API_TOKEN}` } },
        CACHE_TTL.NAV,
    );
    techZoneEntries = json?.data?.s1_tech_zone ?? [];
} catch {
    techZoneEntries = [];
}

const newsItems: NewsCard[] = techZoneEntries.flatMap((entry) =>
    (entry.articles ?? []).map((a) => {
        const link = resolveArticleLink(a.news_category, a.news_article_id, a.news_article_url);
        return {
            bigTitle: wrapEvery4Chars(entry.tech_title),
            image: resolveArticleImage(a.news_image, a.news_featured_image_url, '/news-image-01.jpg'),
            title: a.news_title,
            description: resolveSummary(a.news_summary, stripHtml(a.news_content_html, 60)),
            tags: (a.news_tag ?? []).map((t) => t.name),
            href: link.href,
            external: link.external,
            hasVideo: Boolean(a.news_youtube_id),
        };
    }),
);
---
<section data-nav="light">
    <div id="signals">
        <div class="stickyWrap">
            <div class="pinInner">
                <div class="inBox">
                    <div class="flex">
                        <div class="titleBox">
                            <div class="itemTitle">
                                <p>最新科技情報</p>
                                <p>TECH SIGNALS</p>
                            </div>
                            <div class="title">
                                <div class="titleTrack">
                                    <div class="titleLine" set:html={newsItems[0]?.bigTitle}></div>
                                </div>
                            </div>
                        </div>
                        <div class="list">
                            <div class="itemTrack">
                                {newsItems.map((item, i) => (
                                    <div class="item" class:list={{ 'is-active': i === 0 }} data-index={i} data-rel={Math.min(2, i)} data-big-title={item.bigTitle}>
                                        <a href={item.href} class="cardLink" target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined}>
                                            <div class="img">
                                                <img width="600" height="342" src={item.image} alt="img" />
                                                {item.hasVideo ? (
                                                    <div class="statusIcon playIcon"></div>
                                                ) : (
                                                    <div class="cardArraw">
                                                        <img width="28" height="28" src="/arraw-right-01.svg" alt="arraw" />
                                                    </div>
                                                )}
                                            </div>
                                            <div class="txtBox">
                                                <div class="title">
                                                    {item.title}
                                                </div>
                                                <div class="description">
                                                    {item.description}
                                                </div>
                                                <div class="tag">
                                                    {item.tags.map((tag) => <span>{tag}</span>)}
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                ))}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    // ===== 最新科技情報（#signals）：捲動連動切換 3 則新聞卡 =====
    // 用一段「釘住 + 加高」的區塊模擬 Apple 官網式 scrollytelling：
    // 區塊釘在畫面上，使用者往下捲動時依序切到下一則新聞卡；捲完最後一則後自然放行接續到下一區塊。
    // 因為是純粹依據捲動位置計算（而非攔截 wheel 事件），滾輪、觸控板、鍵盤、觸控捲動都能正確運作，往上捲動也會自動反向切換。
    const stickyWrap = document.querySelector<HTMLElement>('#signals .stickyWrap');
    const pinInner = document.querySelector<HTMLElement>('#signals .pinInner');
    const items = document.querySelectorAll<HTMLElement>('#signals .list .item');
    const titleEl = document.querySelector<HTMLElement>('#signals .titleBox .title');
    const titleTrackEl = document.querySelector<HTMLElement>('#signals .titleBox .titleTrack');

    if (stickyWrap && pinInner && items.length) {
        // 1024px 以下：pinInner 高度是隨內容撐開（非固定 100vh），實際放行時機以量到的高度為準，
        // 不能假設它跟螢幕一樣高，否則捲動距離的計算會跟瀏覽器實際放行的時機對不上，出現多滾一大段的空白。
        // 手機跟桌機用同一套 step 算法，但手指一次滑過的距離比滾輪 1 格大，
        // 所以手機 step 拉長，避免一次滑就連切好幾張。
        const mobileQuery = window.matchMedia('(max-width: 1023px)');
        const MOBILE_STEP_VH = 32;
        const MOBILE_TAIL_VH = 8;
        const DESKTOP_STEP_VH = 32;
        const DESKTOP_TAIL_VH = 8;

        let cachedScrollable = 0;
        let cachedStepPx = 1;
        let lastViewportWidth = window.innerWidth;
        let ticking = false;
        let sectionInView = true;
        let switching = false;
        let lockY = 0;
        let switchTimer: number | undefined;

        // 跟 CSS 換卡 transition 對齊：≤767 是 1s，平板 0.35s。鎖住期間不讓手指把捲動疊加到下一張。
        function switchDuration() {
            if (window.matchMedia('(max-width: 767px)').matches) return 1000;
            if (mobileQuery.matches) return 350;
            return 0;
        }

        function preventTouchScroll(e: TouchEvent) {
            e.preventDefault();
        }

        function unlockSwitch() {
            switching = false;
            window.removeEventListener('touchmove', preventTouchScroll);
            document.documentElement.style.touchAction = '';
        }

        function lockForSwitch(index: number) {
            const ms = switchDuration();
            if (ms <= 0) return;
            const currentScrolled = -stickyWrap!.getBoundingClientRect().top;
            const targetScrolled = index * cachedStepPx;
            const nextY = window.scrollY + (targetScrolled - currentScrolled);
            window.scrollTo(0, nextY);
            lockY = nextY;
            switching = true;
            document.documentElement.style.touchAction = 'none';
            window.addEventListener('touchmove', preventTouchScroll, { passive: false });
            window.clearTimeout(switchTimer);
            switchTimer = window.setTimeout(unlockSwitch, ms);
        }

        function setHeight() {
            const isMobile = mobileQuery.matches;
            const stepVh = isMobile ? MOBILE_STEP_VH : DESKTOP_STEP_VH;
            const tailVh = isMobile ? MOBILE_TAIL_VH : DESKTOP_TAIL_VH;
            // 用當下視窗高度鎖定 step，之後捲動中不再重算——iOS 網址列收合會讓 innerHeight
            // 變大，若每幀跟著改 step，卡片索引會在手指還在滑時跳動。
            const vh = isMobile
                ? (window.visualViewport?.height ?? window.innerHeight)
                : window.innerHeight;
            cachedStepPx = (stepVh / 100) * vh;
            const tailPx = (tailVh / 100) * vh;
            cachedScrollable = (items.length - 1) * cachedStepPx + tailPx;
            stickyWrap!.style.height = `${pinInner!.offsetHeight + cachedScrollable}px`;
        }

        let activeIndex = 0;
        let pushTimer: number | undefined;

        // 大標題只在真的換文字時（捲過組界）才切換，同一組內的卡片切換不會誤觸發：
        // 新文字從下方接上舊文字，兩行一起往上位移，把舊文字推出 .title 的裁切範圍，
        // 位移動畫播完後移除舊的那行、軌道歸位，這樣下次切換才會從乾淨的單行狀態開始。
        //
        // 使用者快速上下捲動時，這個函式可能在前一次動畫的 350ms 計時器還沒結束前就被再次觸發：
        // 如果只是單純 clearTimeout 前一個計時器、繼續疊加下一行，殘留的舊行會一直沒被移除、
        // 一路往 track 裡堆積，.title 的高度鎖定也會跟著失效，導致整塊往下撐開版面（跑版）。
        // 所以每次呼叫一開始就強制把 track 內除了「最後一行」以外的殘留行全部清掉、位移瞬間歸零，
        // 確保不管觸發幾次、觸發得多密集，都一定是從乾淨的單行狀態重新開始。
        function pushBigTitle(nextHtml: string) {
            const track = titleTrackEl;
            if (!titleEl || !track) return;
            const lines = Array.from(track.querySelectorAll<HTMLElement>('.titleLine'));
            const currentLine = lines[lines.length - 1];
            if (!currentLine || currentLine.innerHTML === nextHtml) return;
            window.clearTimeout(pushTimer);

            lines.slice(0, -1).forEach((el) => el.remove());
            track.style.transition = 'none';
            track.style.transform = 'translateY(0)';
            void track.offsetWidth; // 強制 reflow，讓上面的瞬間歸位先生效，避免跟接下來的位移動畫混在一起

            // 換行數（2 行或 3 行）可能因文字長度不同而變，先把裁切範圍鎖定在「目前」這行的高度，
            // 否則等一下把新的一行接進 track 後，.title 會直接被撐高、兩行同時整段露出來，看不出推擠效果
            const pushDistance = currentLine.offsetHeight;
            titleEl.style.height = `${pushDistance}px`;

            const nextLine = document.createElement('div');
            nextLine.className = 'titleLine';
            nextLine.innerHTML = nextHtml;
            track.appendChild(nextLine);

            track.style.transition = 'transform 0.35s ease';
            track.style.transform = `translateY(-${pushDistance}px)`;

            pushTimer = window.setTimeout(() => {
                currentLine.remove();
                titleEl!.style.height = ''; // 交還給新的一行自然撐開高度，下次切換時會依新內容重新鎖定
                track.style.transition = 'none';
                track.style.transform = 'translateY(0)';
            }, 350);
        }

        function setActive(index: number) {
            if (switching) return;
            const inited = Boolean(stickyWrap!.dataset.inited);
            if (index === activeIndex && inited) return;
            // 手機動畫期間一次只走一張，避免慣性滑動一次跳過多張；桌機維持原本跟滾輪走
            if (inited && mobileQuery.matches) {
                if (index > activeIndex) index = activeIndex + 1;
                else if (index < activeIndex) index = activeIndex - 1;
            }
            activeIndex = index;
            stickyWrap!.dataset.inited = 'true';
            items.forEach((item, i) => {
                item.classList.toggle('is-active', i === index);
                // 相對位置：0 為當前卡片，正數為疊在下方待出現的卡片，負數為已經翻過去的卡片
                const rel = String(Math.max(-1, Math.min(2, i - index)));
                if (item.dataset.rel !== rel) item.dataset.rel = rel;
            });
            pushBigTitle(items[index]?.dataset.bigTitle ?? '');
            if (inited) lockForSwitch(index);
        }

        function update() {
            if (switching || cachedScrollable <= 0) {
                if (!switching) setActive(0);
                return;
            }
            const scrolled = Math.min(Math.max(-stickyWrap!.getBoundingClientRect().top, 0), cachedScrollable);
            const index = Math.min(items.length - 1, Math.floor(scrolled / cachedStepPx));
            setActive(index);
        }

        function onScroll() {
            if (switching) {
                if (window.scrollY !== lockY) window.scrollTo(0, lockY);
                return;
            }
            if (!sectionInView || ticking) return;
            ticking = true;
            requestAnimationFrame(() => {
                update();
                ticking = false;
            });
        }

        function onResize() {
            // iOS 網址列收合會觸發 resize，若跟著重算 stickyWrap 高度，整段會在滑動途中突然變長變短。
            // 只在寬度真的變了（旋轉／桌機拉視窗）才重算。
            if (mobileQuery.matches && window.innerWidth === lastViewportWidth) return;
            lastViewportWidth = window.innerWidth;
            setHeight();
            update();
        }

        setHeight();

        // #signals 的 stickyWrap 高度是這裡才用 JS 撐開（最多可達好幾個 items.length*100vh），在這之前
        // #signals 後面所有區塊（#spotlight、#video…）在版面上的位置都還是「撐開前」的暫時位置。如果使用者是
        // 直接以帶 hash 的網址進站（例如書籤／分享連結 /#spotlight；跨頁導覽列點擊已改用 Header.astro 的
        // sessionStorage 機制，不會再帶 hash），瀏覽器原生的錨點捲動可能已經用「撐開前」的錯誤位置捲完了，
        // 撐開後目標區塊的位置整個往下移，捲動位置就會停在 #signals 撐開後的某個中間點（看起來像卡在某一動）。這裡撐開高度後，
        // 立刻用目前算好的最終版面位置重新捲一次到同一個錨點做校正；用 behavior:'auto' 瞬間跳
        // （不需要滾動效果，見前面 Header.astro 同樣的處理方式），避免又疊加一段平滑捲動動畫。
        //
        // 這裡同步執行的時機不保證一定晚於瀏覽器原生的錨點捲動——實測發現真的用滑鼠點連結、
        // 觸發完整換頁時，原生捲動有時比這段同步 script 更晚才發生，單靠這裡校正一次會被原生捲動
        // 蓋回去。所以除了進站當下立刻校正一次，額外在 window 的 load 事件（所有資源都載入完成，
        // 保證比瀏覽器原生錨點捲動更晚）再校正一次，確保無論原生捲動實際發生在哪個時間點都能蓋回正確位置。
        function correctHashScroll() {
            if (location.hash.length <= 1) return;
            const target = document.getElementById(location.hash.slice(1));
            if (!target) return;
            const html = document.documentElement;
            const prevScrollBehavior = html.style.scrollBehavior;
            html.style.scrollBehavior = 'auto';
            target.scrollIntoView({ block: 'start' });
            html.style.scrollBehavior = prevScrollBehavior;
        }
        correctHashScroll();
        window.addEventListener('load', correctHashScroll);

        update();
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onResize);
        new IntersectionObserver((entries) => {
            sectionInView = entries[0]?.isIntersecting ?? true;
            if (sectionInView) update();
        }, { rootMargin: '200px 0px' }).observe(stickyWrap);
    }
</script>
