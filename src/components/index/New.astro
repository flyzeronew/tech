---
import '../../styles/components/index/new.css';

interface ArticleData {
    news_title: string;
    news_category: string | null;
    news_content_html: string | null;
    news_featured_image_url: string | null;
    news_article_url: string | null;
    news_youtube_id: string | null;
}

interface TechZone {
    tech_title: string;
    tech_small_title: string;
    teck_block: ArticleData[];
}

interface NewsCard {
    image: string;
    title: string;
    description: string;
    tags: string[];
    href: string;
    hasVideo: boolean;
}

// news_content_html 是完整文章全文，後台目前沒有獨立的摘要欄位，暫時用截斷全文取代（跟 Hero.astro 的做法一致）
function stripHtml(html: string | null, maxLength: number): string {
    if (!html) return '';
    const text = html.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
    return text.length > maxLength ? `${text.slice(0, maxLength)}…` : text;
}

let techZone: TechZone | null = null;
try {
    const res = await fetch(
        `${import.meta.env.STRAPI_URL}/api/index-page?populate[s1_tech_zone][populate]=teck_block`,
        { headers: { Authorization: `Bearer ${import.meta.env.STRAPI_API_TOKEN}` } },
    );
    if (res.ok) {
        const json = await res.json();
        techZone = json.data?.s1_tech_zone?.[0] ?? null;
    }
} catch {
    techZone = null;
}

const itemTitle = {
    main: techZone?.tech_title ?? '最新科技情報',
    small: techZone?.tech_small_title ?? 'TECH SIGNALS',
};

const newsItems: NewsCard[] = (techZone?.teck_block ?? []).map((a) => ({
    image: a.news_featured_image_url ?? '/news-image-01.jpg',
    title: a.news_title,
    description: stripHtml(a.news_content_html, 60),
    tags: a.news_category ? [a.news_category] : [],
    href: a.news_article_url ?? '#',
    hasVideo: Boolean(a.news_youtube_id),
}));
---
<section data-nav="light">
    <div id="new">
        <div class="stickyWrap">
            <div class="pinInner">
                <div class="inBox">
                    <div class="flex">
                        <div class="titleBox">
                            <div class="itemTitle">
                                <p>{itemTitle.main}</p>
                                <p>{itemTitle.small}</p>
                            </div>
                            <div class="title">
                                讀懂<span>趨勢</span><br>
                                再<span>行動</span>
                            </div>
                        </div>
                        <div class="list">
                            <div class="itemTrack">
                                {newsItems.map((item, i) => (
                                    <div class="item" class:list={{ 'is-active': i === 0 }} data-index={i} data-rel={Math.min(2, i)}>
                                        <a href={item.href} class="cardLink" target="_blank" rel="noopener noreferrer">
                                            <div class="img">
                                                <img width="600" height="342" src={item.image} alt="img" />
                                                {item.hasVideo ? (
                                                    <div class="statusIcon playIcon"></div>
                                                ) : (
                                                    <div class="cardArraw">
                                                        <img width="28" height="28" src="/arraw-right-01.svg" alt="arraw" />
                                                    </div>
                                                )}
                                            </div>
                                            <div class="txtBox">
                                                <div class="title">
                                                    {item.title}
                                                </div>
                                                <div class="description">
                                                    {item.description}
                                                </div>
                                                <div class="tag">
                                                    {item.tags.map((tag) => <span>{tag}</span>)}
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                ))}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    // ===== 最新科技情報（#new）：捲動連動切換 3 則新聞卡 =====
    // 用一段「釘住 + 加高」的區塊模擬 Apple 官網式 scrollytelling：
    // 區塊釘在畫面上，使用者往下捲動時依序切到下一則新聞卡；捲完最後一則後自然放行接續到下一區塊。
    // 因為是純粹依據捲動位置計算（而非攔截 wheel 事件），滾輪、觸控板、鍵盤、觸控捲動都能正確運作，往上捲動也會自動反向切換。
    const stickyWrap = document.querySelector<HTMLElement>('#new .stickyWrap');
    const pinInner = document.querySelector<HTMLElement>('#new .pinInner');
    const items = document.querySelectorAll<HTMLElement>('#new .list .item');

    if (stickyWrap && pinInner && items.length) {
        // 1024px 以下：pinInner 高度是隨內容撐開（非固定 100vh），實際放行時機以量到的高度為準，
        // 不能假設它跟螢幕一樣高，否則捲動距離的計算會跟瀏覽器實際放行的時機對不上，出現多滾一大段的空白
        const mobileQuery = window.matchMedia('(max-width: 1023px)');
        const MOBILE_STEP_VH = 100;
        const MOBILE_TAIL_VH = 20;

        function setHeight() {
            if (mobileQuery.matches) {
                const stepPx = (MOBILE_STEP_VH / 100) * window.innerHeight;
                const tailPx = (MOBILE_TAIL_VH / 100) * window.innerHeight;
                const scrollDistance = (items.length - 1) * stepPx + tailPx;
                stickyWrap!.style.height = `${pinInner!.offsetHeight + scrollDistance}px`;
            } else {
                stickyWrap!.style.height = `${items.length * 100}vh`;
            }
        }

        let activeIndex = 0;

        function setActive(index: number) {
            if (index === activeIndex && stickyWrap!.dataset.inited) return;
            activeIndex = index;
            stickyWrap!.dataset.inited = 'true';
            items.forEach((item, i) => {
                item.classList.toggle('is-active', i === index);
                // 相對位置：0 為當前卡片，正數為疊在下方待出現的卡片，負數為已經翻過去的卡片
                const rel = Math.max(-1, Math.min(2, i - index));
                item.dataset.rel = String(rel);
            });
        }

        function update() {
            const rect = stickyWrap!.getBoundingClientRect();
            if (mobileQuery.matches) {
                const scrollable = stickyWrap!.offsetHeight - pinInner!.offsetHeight;
                if (scrollable <= 0) {
                    setActive(0);
                    return;
                }
                const scrolled = Math.min(Math.max(-rect.top, 0), scrollable);
                const stepPx = (MOBILE_STEP_VH / 100) * window.innerHeight;
                const index = Math.min(items.length - 1, Math.floor(scrolled / stepPx));
                setActive(index);
            } else {
                const scrollable = stickyWrap!.offsetHeight - window.innerHeight;
                if (scrollable <= 0) {
                    setActive(0);
                    return;
                }
                const scrolled = Math.min(Math.max(-rect.top, 0), scrollable);
                const progress = scrolled / scrollable;
                const index = Math.min(items.length - 1, Math.floor(progress * items.length));
                setActive(index);
            }
        }

        setHeight();
        update();
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', () => {
            setHeight();
            update();
        });
    }
</script>
