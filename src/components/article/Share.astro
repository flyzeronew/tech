---
import '../../styles/components/article/share.css';
---
<section>
    <div id="share">
        <div class="inBox">
            <div class="shareBox">
                <div class="fixed">
                    <div class="community">
                        <a href="https://www.linkedin.com/showcase/tvbs-tech/" target="_blank">
                            <img width="24" height="24 " src="/ic-linkedin.svg" alt="linkedin" />
                        </a>
                        <a href="https://www.youtube.com/watch?v=JPmb6UzzpBo&list=PLmVlUjKuEG7SikBn4h8gZKuN0gn_yxetj" target="_blank">
                            <img width="24" height="24 " src="/ic-youtube.svg" alt="line" />
                        </a>
                        <a href="https://podcasts.apple.com/tw/podcast/%E6%96%B0%E8%81%9E%E5%B9%95%E5%BE%8C/id1737083276" target="_blank">
                            <img width="24" height="24 " src="/ic-podcast.svg" alt="apple podcasts" />
                        </a>
                    </div>
                    <div class="goTop">
                        <a href="#">
                            <img width="24" height="24 " src="/arraw-right-02.svg" alt="top" />
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    // ===== goTop：點擊滑動回頁面頂部 =====
    // 不使用 scrollTo(behavior:'smooth')：它會跟 href="#" 的原生錨點捲動互相搶同一個捲軸，
    // 導致捲一半就卡住。改成自己用 requestAnimationFrame 緩動、behavior:'auto'，避開衝突。
    function easeInOutCubic(t: number) {
        return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    }

    document.querySelector<HTMLAnchorElement>('#share .goTop a')?.addEventListener('click', (e) => {
        e.preventDefault();
        const DURATION = 600;
        const startY = window.scrollY;
        const startTime = performance.now();
        function tick(now: number) {
            const t = Math.min((now - startTime) / DURATION, 1);
            window.scrollTo({ top: startY * (1 - easeInOutCubic(t)), behavior: 'auto' });
            if (t < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
    });
</script>
