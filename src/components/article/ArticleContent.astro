---
import '../../styles/components/article/article-content.css';
import type { ArticleDetail } from '../../lib/articleDetail';
import { CATEGORY_META } from '../../lib/categoryArticles';

interface Props {
    article: ArticleDetail;
}

const { article } = Astro.props;
const categoryMeta = CATEGORY_META[article.category];

const authorText = article.authors
    .map((a) => (a.role ? `${a.role}：${a.name}` : a.name))
    .join(' | ');
---
<section>
    <div id="article">
        <div class="articleInBox">
            <div class="newsArticle">
                <div class="breadcrumbs">
                    <a href="/">首頁</a>
                    <a href={`/${article.category}`}>{categoryMeta?.title ?? article.category}</a>
                </div>
                <div class="mainTitle">
                    {article.title}
                </div>
                {authorText && (
                    <div class="authorBox">
                        <div class="author">{authorText}</div>
                        {article.publishedAt && <div class="publishTime">發佈時間：{article.publishedAt}</div>}
                        {article.updatedAt && <div class="updateTime">最後更新時間：{article.updatedAt}</div>}
                    </div>
                )}
                <div class="mainImg">
                    <img src={article.image} alt={article.title} width="768" height="432" />
                </div>
                {article.youtubeId && (
                    <div class="mainVideo">
                        <iframe
                            width="100%"
                            height="100%"
                            src={`https://www.youtube.com/embed/${article.youtubeId}`}
                            title={article.title}
                            frameborder="0"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                            allowfullscreen
                        ></iframe>
                    </div>
                )}
                <div class="content" set:html={article.contentHtml}></div>
                {article.tags.length > 0 && (
                    <div class="tags">
                        {article.tags.map((tag) => <a href="#">{tag}</a>)}
                    </div>
                )}
                <div class="community">
                    <a href="https://www.linkedin.com/showcase/tvbs-tech/" target="_blank">
                        <img width="24" height="24 " src="/ic-linkedin.svg" alt="linkedin" />
                    </a>
                    <a href="https://www.youtube.com/playlist?list=PLmVlUjKuEG7SikBn4h8gZKuN0gn_yxetj" target="_blank">
                        <img width="24" height="24 " src="/ic-youtube.svg" alt="line" />
                    </a>
                    <a href="https://podcasts.apple.com/tw/podcast/%E6%96%B0%E8%81%9E%E5%B9%95%E5%BE%8C/id1737083276" target="_blank">
                        <img width="24" height="24 " src="/ic-podcast.svg" alt="apple podcasts" />
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    // ===== 文章引用（.citation）展開/收合（slideDown / slideUp）=====
    const SLIDE_DURATION = 300;

    function slideDown(el: HTMLElement, duration = SLIDE_DURATION) {
        el.style.display = 'block';
        const height = el.scrollHeight;
        el.style.overflow = 'hidden';
        el.style.height = '0px';
        el.style.transition = `height ${duration}ms ease`;
        requestAnimationFrame(() => {
            el.style.height = `${height}px`;
        });
        window.setTimeout(() => {
            el.style.removeProperty('height');
            el.style.removeProperty('overflow');
            el.style.removeProperty('transition');
        }, duration);
    }

    function slideUp(el: HTMLElement, duration = SLIDE_DURATION) {
        el.style.overflow = 'hidden';
        el.style.height = `${el.scrollHeight}px`;
        el.style.transition = `height ${duration}ms ease`;
        requestAnimationFrame(() => {
            el.style.height = '0px';
        });
        window.setTimeout(() => {
            el.style.display = 'none';
            el.style.removeProperty('height');
            el.style.removeProperty('overflow');
            el.style.removeProperty('transition');
        }, duration);
    }

    // 文章內文（news_content_html）如果本身就含有 .faq 結構，沿用同一套展開/收合互動
    document.querySelectorAll<HTMLElement>('#article .content .faq .faqItem').forEach((faqItem) => {
        const trigger = faqItem.querySelector<HTMLElement>('.question');
        const answer = faqItem.querySelector<HTMLElement>('.answer');
        trigger?.addEventListener('click', () => {
            const isOpen = faqItem.classList.toggle('is-open');
            if (!answer) return;
            if (isOpen) {
                slideDown(answer);
            } else {
                slideUp(answer);
            }
        });
    });
</script>
