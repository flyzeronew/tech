            <div class="navBox">
                <div class="logo">
                    <img width="165" height="24" src="/tvbs-logo.svg" alt="logo" />
                </div>
                <div class="menu">
                    <ul>
                        <li class="hasSub">
                            <a href="#" class="act dropdown">
                                AI最新趨勢
                                <span class="arraw">
                                    <img width="20" height="20" src="/direction-down.svg" alt="arraw" />
                                </span>
                            </a>
                            <ul class="subMenu">
                                <li><a href="#">子選單1</a></li>
                                <li><a href="#">子選單2</a></li>
                            </ul>
                        </li>
                        <li>
                            <a href="#new" class="act">亞利桑那觀察</a>
                        </li>
                        <li>
                            <a href="#issue">專題</a>
                        </li>
                        <li>
                            <a href="#video">影音</a>
                        </li>
                        <li>
                            <a href="#crossover">財經</a>
                        </li>
                        <li>
                            <a href="#experts">專欄</a>
                        </li>
                        <li>
                            <a href="#publications">出版</a>
                        </li>
                        <li>
                            <a href="#partners">合作</a>
                        </li>
                    </ul>
                </div>
                <div class="switch">
                    <span>Classic</span>
                    <label class="btn">
                        <input type="checkbox" id="viewSwitch" />
                        <span class="slider"></span>
                    </label>
                    <span>Story</span>
                </div>
            </div>
        </div>
    </nav>
</header>

<script>
    // ===== 導覽列錨點連結：緩速滑動至目標區塊（原生 smooth 速度太快，改用自訂緩動動畫）=====
    const DURATION = 1200; // 捲動時間（毫秒），數字越大滑動越慢
    // 導覽列是浮在內容上方的透明懸浮列，捲動時直接讓區塊頂到「視窗最頂端」即可，不用再扣除導覽列高度

    function easeInOutCubic(t: number) {
        return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    }

    document.querySelectorAll<HTMLAnchorElement>('header nav a[href^="#"]').forEach((link) => {
        link.addEventListener('click', (e) => {
            const href = link.getAttribute('href');
            if (!href) return;
            const id = href.slice(1);
            const isDropdownToggle = link.classList.contains('dropdown');

            // href="#" 且非「AI最新趨勢」主按鈕（例如子選單）尚未串接目標區塊，不做任何捲動
            if (!id && !isDropdownToggle) {
                e.preventDefault();
                return;
            }
            // 「AI最新趨勢」主按鈕沒有對應區塊，點擊時捲回頁首
            const target = id ? document.getElementById(id) : null;
            if (id && !target) return;

            e.preventDefault();

            const startY = window.scrollY;
            const targetY = target
                ? target.getBoundingClientRect().top + startY
                : 0;
            const startTime = performance.now();

            function tick(now: number) {
                const t = Math.min((now - startTime) / DURATION, 1);
                // 明確指定 behavior: 'auto'，避免與 CSS 的 scroll-behavior: smooth 疊加造成頓挫
                window.scrollTo({ top: startY + (targetY - startY) * easeInOutCubic(t), behavior: 'auto' });
                if (t < 1) requestAnimationFrame(tick);
            }
            requestAnimationFrame(tick);
        });
    });
</script>

<script>
    // ===== 導覽列樣式隨滾動切換 =====
    // 置頂：維持原狀（白色 logo/箭頭，無 type class）
    // 捲動後，依「導覽列所在位置」底下的區塊是深色／淺色背景，切換 type1（深色背景，白字白圖）
    // 或 type2（淺色背景，黑字黑圖），並同步替換 logo／箭頭圖檔
    const nav = document.querySelector<HTMLElement>('header nav');
    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-nav]'));
    const logoImg = nav?.querySelector<HTMLImageElement>('.logo img');
    const arrawImg = nav?.querySelector<HTMLImageElement>('.menu a.dropdown .arraw img');

    if (nav && logoImg && arrawImg && sections.length) {
        const LOGO_WHITE = '/tvbs-logo.svg';
        const LOGO_BLACK = '/tvbs-logo-b.svg';
        const ARRAW_WHITE = '/direction-down.svg';
        const ARRAW_BLACK = '/direction-down-b.svg';
        const NEAR = 2; // 跟 Video.astro 的置頂判斷一致，避免抖動誤判

        let currentState: 'top' | 'dark' | 'light' | null = null;

        function applyState(state: 'top' | 'dark' | 'light') {
            if (state === currentState) return;
            currentState = state;
            nav!.classList.remove('type1', 'type2');
            if (state === 'top') {
                logoImg!.src = LOGO_WHITE;
                arrawImg!.src = ARRAW_WHITE;
            } else if (state === 'dark') {
                nav!.classList.add('type1');
                logoImg!.src = LOGO_WHITE;
                arrawImg!.src = ARRAW_WHITE;
            } else {
                nav!.classList.add('type2');
                logoImg!.src = LOGO_BLACK;
                arrawImg!.src = ARRAW_BLACK;
            }
        }

        function update() {
            if (Math.abs(window.scrollY) <= NEAR) {
                applyState('top');
                return;
            }
            const probeY = nav!.getBoundingClientRect().height / 2;
            const current = sections.find((sec) => {
                const rect = sec.getBoundingClientRect();
                return rect.top <= probeY && rect.bottom > probeY;
            });
            applyState(current?.dataset.nav === 'dark' ? 'dark' : 'light');
        }

        let ticking = false;
        function onScroll() {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(() => {
                update();
                ticking = false;
            });
        }

        update();
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
    }
</script>
