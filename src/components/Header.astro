---
import { STRAPI_URL, STRAPI_API_TOKEN } from 'astro:env/server';
import '../styles/components/header.css';
import { cachedFetchJson, CACHE_TTL } from '../lib/fetchCache';

interface SubLink {
    link_name: string;
    link_url: string;
    link_syle: string | null;
    link_icon: string | null;
}

interface LinkInfo {
    __component: 'shared.link-info';
    link_name: string;
    link_url: string;
    link_syle: string | null;
    link_icon: string | null;
}

interface SubLinkInfo {
    __component: 'shared.sub-link-info';
    sub_name: string;
    link_syle: string | null;
    sub_link: SubLink[];
}

type NavItem = LinkInfo | SubLinkInfo;

let navItems: NavItem[] = [];
try {
    const json = await cachedFetchJson<{ data?: { nav?: NavItem[] } }>(
        `${STRAPI_URL}/api/nav-bar?populate[nav][on][shared.sub-link-info][populate]=*&populate[nav][on][shared.link-info]=true`,
        { headers: { Authorization: `Bearer ${STRAPI_API_TOKEN}` } },
        CACHE_TTL.NAV,
    );
    navItems = json?.data?.nav ?? [];
} catch {
    navItems = [];
}

// 導覽列的錨點連結（例如 #spotlight、#crossover）對應的區塊都只存在首頁。在首頁上維持原本的
// bare "#spotlight"，讓下面的 script 用自訂緩動捲動；不在首頁時，把 href 算成完整的 "/#spotlight"，
// 讓連結本身仍然是可以被「開新分頁」「複製連結」等原生操作正常使用的合法網址；
// 但一般左鍵點擊會被下面的 script 攔截，改用 sessionStorage 記錄目標、不帶 hash 導回首頁根路徑，
// 進站後在 window 的 load 事件才真正捲動——不能單純依賴瀏覽器原生的錨點捲動，因為 #signals 的
// scrollytelling 區塊（見 New.astro）是進站後才用 JS 把高度撐開到好幾倍 viewport，原生捲動的
// 時機不保證晚於這個撐開動作，實測會不穩定地卡在 #signals 中間。"#top" 沒有對應區塊，不在首頁時
// 直接連回根路徑就好（新頁面本來就從頂端開始，不需要額外記錄捲動目標）。
const isHomepage = Astro.url.pathname === '/';
function resolveNavHref(url: string): string {
    if (!url.startsWith('#') || url === '#' || isHomepage) return url;
    return url === '#top' ? '/' : `/${url}`;
}
function anchorId(url: string): string | undefined {
    return url.startsWith('#') && url !== '#' ? url.slice(1) : undefined;
}
---
<header>
    <div id="top"></div>
    <nav>
        <div class="pc">
            <!-- 與 .box 同層的模糊層：避免 backdrop-filter 建在祖先上導致 .subMenu 模糊失效 -->
            <div class="navBlur" aria-hidden="true"></div>
            <div class="box">
                <div class="navBox">
                    <div class="logo">
                        <a href="/">
                            <img width="165" height="24" src="/tvbs-logo.svg" alt="logo" />
                        </a>
                    </div>
                    <div class="menu">
                        <ul>
                            {navItems.map((item) => (
                                item.__component === 'shared.sub-link-info' && item.sub_link.length > 0 ? (
                                    <li class="hasSub">
                                        <a href="#" class:list={['dropdown', { act: item.link_syle === 'act' }]}>
                                            {item.sub_name}
                                            <span class="arraw"></span>
                                        </a>
                                        <ul class="subMenu">
                                            {item.sub_link.map((sub) => (
                                                <li><a href={sub.link_url}>{sub.link_name}</a></li>
                                            ))}
                                        </ul>
                                    </li>
                                ) : item.__component === 'shared.sub-link-info' ? (
                                    <li>
                                        <a href="#" class:list={{ act: item.link_syle === 'act' }}>{item.sub_name}</a>
                                    </li>
                                ) : (
                                    <li>
                                        <a href={resolveNavHref(item.link_url)} data-anchor-id={anchorId(item.link_url)} class:list={{ act: item.link_syle === 'act' }}>{item.link_name}</a>
                                    </li>
                                )
                            ))}
                        </ul>
                    </div>
                    <!-- <div class="switch">
                        <span>Classic</span>
                        <label class="btn">
                            <input type="checkbox" id="viewSwitch" />
                            <span class="slider"></span>
                        </label>
                        <span>Story</span>
                    </div> -->
                </div>
            </div>
        </div>
        <div class="mobile">
            <div class="bar">
                <div class="logo">
                    <a href="/">
                        <img width="165" height="24" src="/tvbs-logo.svg" alt="logo" />
                    </a>
                </div>
                <div class="burger">
                    <div class="open">
                        <img width="28" height="28" src="/burger.svg" alt="burger" />
                    </div>
                    <div class="close">
                        <img width="28" height="28" src="/close.svg" alt="burger" />
                    </div>
                </div>
            </div>
            <div class="menuBox">
                <ul>
                    {navItems.map((item) => (
                        item.__component === 'shared.sub-link-info' && item.sub_link.length > 0 ? (
                            <li class:list={['hasSub', { act: item.link_syle === 'act' }]}>
                                <a href="#">
                                    <span>{item.sub_name}</span>
                                    <span class="arraw"></span>
                                </a>
                                <div class="subMenu">
                                    {item.sub_link.map((sub) => (
                                        <a href={sub.link_url}>{sub.link_name}</a>
                                    ))}
                                </div>
                            </li>
                        ) : item.__component === 'shared.sub-link-info' ? (
                            <li class:list={{ act: item.link_syle === 'act' }}>
                                <a href="#">{item.sub_name}</a>
                            </li>
                        ) : (
                            <li class:list={{ act: item.link_syle === 'act' }}>
                                <a href={resolveNavHref(item.link_url)} data-anchor-id={anchorId(item.link_url)}>{item.link_name}</a>
                            </li>
                        )
                    ))}
                </ul>
            </div>
        </div>
    </nav>
    <div class="menuHeight"></div>
</header>

<script>
    // ===== 導覽列錨點連結 =====
    // 在首頁上：這些連結是 bare "#spotlight" 這種 href，用 a[href^="#"] 選到，播放自訂緩動捲動。
    // 不在首頁時：href 已經在伺服器端算成完整的 "/#spotlight"（見 frontmatter 的 resolveNavHref），
    // 但一般左鍵點擊會被下面第二段攔截，改成不帶 hash、用 sessionStorage 記錄目標後導回首頁，
    // 進站後在 window 的 load 事件才真正捲動（見下方「跨頁捲動」說明，兩段共用同一個 SCROLL_TARGET_KEY）。
    const SCROLL_TARGET_KEY = 'tvbsScrollTarget';
    const DURATION = 1200; // 捲動時間（毫秒），數字越大滑動越慢
    // 導覽列是浮在內容上方的透明懸浮列，捲動時直接讓區塊頂到「視窗最頂端」即可，不用再扣除導覽列高度

    function easeInOutCubic(t: number) {
        return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    }

    function scrollToElementInstant(el: HTMLElement) {
        const html = document.documentElement;
        const prevScrollBehavior = html.style.scrollBehavior;
        html.style.scrollBehavior = 'auto';
        el.scrollIntoView({ block: 'start' });
        html.style.scrollBehavior = prevScrollBehavior;
    }

    // ===== 跨頁捲動：從其他頁面導回首頁後，捲到指定錨點區塊 =====
    // 不能單純依賴瀏覽器原生的錨點捲動（網址帶 #spotlight 直接進站）：#signals 的 scrollytelling 區塊
    // （見 New.astro）是進站後才用 JS 把高度撐開到好幾倍 viewport，原生捲動的時機不保證晚於
    // 這個撐開動作，實測會不穩定地卡在 #signals 中間。改成完全不靠網址上的 hash，用 sessionStorage
    // 記錄要捲到哪個區塊，等 window 的 load 事件（所有資源、版面都撐開穩定後）才真正捲動，
    // 一次讀取後就清掉，重新整理不會再觸發。
    const pendingScrollTarget = sessionStorage.getItem(SCROLL_TARGET_KEY);
    if (pendingScrollTarget) {
        sessionStorage.removeItem(SCROLL_TARGET_KEY);
        const target = document.getElementById(pendingScrollTarget);
        if (target) {
            scrollToElementInstant(target);
            window.addEventListener('load', () => scrollToElementInstant(target));
        }
    }

    // ===== 不在首頁時：攔截點擊，改用上面的跨頁捲動流程 =====
    // 用 data-anchor-id（伺服器端渲染時標記，見 frontmatter 的 anchorId）挑出「連到首頁區塊」的
    // 連結，不管目前 href 是 bare "#spotlight" 還是完整的 "/#spotlight" 都選得到。
    document.querySelectorAll<HTMLAnchorElement>('header nav a[data-anchor-id]').forEach((link) => {
        link.addEventListener('click', (e) => {
            if (location.pathname === '/') return; // 首頁上交給下面第二段的緩動捲動處理
            // 只攔截單純左鍵點擊，開新分頁／複製連結等原生操作維持用 href 本身（完整的 "/#spotlight"）運作
            if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            e.preventDefault();
            const id = link.dataset.anchorId!;
            if (id !== 'top') sessionStorage.setItem(SCROLL_TARGET_KEY, id);
            window.location.href = '/';
        });
    });

    document.querySelectorAll<HTMLAnchorElement>('header nav a[href^="#"]').forEach((link) => {
        link.addEventListener('click', (e) => {
            const href = link.getAttribute('href');
            if (!href) return;
            const id = href.slice(1);
            const isDropdownToggle = link.classList.contains('dropdown');

            // href="#" 且非「AI最新趨勢」主按鈕（例如子選單）尚未串接目標區塊，不做任何捲動
            if (!id && !isDropdownToggle) {
                e.preventDefault();
                return;
            }
            // "#top" 一律代表「頁面最頂端」，不能用 DOM 查詢算目標位置：Header.astro 開頭那個
            // <div id="top"> 每一頁都有渲染，但它在 position:fixed 的 <header> 裡，
            // getBoundingClientRect().top 恆為 0，拿它算 targetY 會變成「捲到目前位置」的無效運算
            // （點擊會整個沒反應），特殊處理成固定目標 0，不查那個 div。
            const isTopLink = id === 'top';
            const target = id && !isTopLink ? document.getElementById(id) : null;

            e.preventDefault();

            document.querySelector('header nav .mobile')?.classList.remove('is-open');

            const startY = window.scrollY;
            const targetY = isTopLink
                ? 0
                : target
                    ? target.getBoundingClientRect().top + startY
                    : 0;

            // 手機版不做捲動動畫，直接跳到錨點位置。
            // 部分行動瀏覽器對 scrollTo() 傳入 behavior:'auto' 不會確實覆蓋掉 global.css 的
            // html{scroll-behavior:smooth}，還是會生成平滑捲動；改成先暫時把 <html> 的
            // scroll-behavior 用 inline style 蓋成 auto，跳轉後再還原，才能保證真的是瞬間跳轉。
            if (window.matchMedia('(max-width: 1023px)').matches) {
                const html = document.documentElement;
                const prevScrollBehavior = html.style.scrollBehavior;
                html.style.scrollBehavior = 'auto';
                window.scrollTo({ top: targetY, behavior: 'auto' });
                html.style.scrollBehavior = prevScrollBehavior;
                return;
            }

            const startTime = performance.now();
            function tick(now: number) {
                const t = Math.min((now - startTime) / DURATION, 1);
                // 明確指定 behavior: 'auto'，避免與 CSS 的 scroll-behavior: smooth 疊加造成頓挫
                window.scrollTo({ top: startY + (targetY - startY) * easeInOutCubic(t), behavior: 'auto' });
                if (t < 1) requestAnimationFrame(tick);
            }
            requestAnimationFrame(tick);
        });
    });
</script>

<script>
    // ===== 導覽列樣式隨滾動切換 =====
    // 置頂：維持原狀（白色 logo，無 type class）
    // 捲動後，依「導覽列所在位置」底下的區塊是深色／淺色背景，切換 type1（深色背景，白字）
    // 或 type2（淺色背景，黑字），並同步替換 logo 圖檔
    // data-nav="type0"：區塊標記為 type0（品牌藍底 logo）時，導覽列切換為 type0
    // 下拉箭頭的顏色改交給 CSS 依 nav 的 type1/type2 class 加上該項目自己的 .act class 決定
    // （每個下拉項目的 act 狀態可能不同，不能用單一 JS 變數統一切換所有箭頭顏色）
    const nav = document.querySelector<HTMLElement>('header nav .pc');
    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-nav]'));
    const logoImg = nav?.querySelector<HTMLImageElement>('.logo img');

    if (nav && logoImg && sections.length) {
        const LOGO_WHITE = '/tvbs-logo.svg';
        const LOGO_BLACK = '/tvbs-logo-b.svg';
        const NEAR = 2; // 跟 Video.astro 的置頂判斷一致，避免抖動誤判

        let currentState: 'top' | 'dark' | 'light' | 'type0' | null = null;

        function applyState(state: 'top' | 'dark' | 'light' | 'type0') {
            if (state === currentState) return;
            currentState = state;
            nav!.classList.remove('type0', 'type1', 'type2');
            if (state === 'top') {
                logoImg!.src = LOGO_WHITE;
            } else if (state === 'dark') {
                nav!.classList.add('type1');
                logoImg!.src = LOGO_WHITE;
            } else if (state === 'light') {
                nav!.classList.add('type2');
                logoImg!.src = LOGO_BLACK;
            } else {
                nav!.classList.add('type0');
                logoImg!.src = LOGO_WHITE;
            }
        }

        function update() {
            if (Math.abs(window.scrollY) <= NEAR) {
                applyState('top');
                return;
            }
            const probeY = nav!.getBoundingClientRect().height / 2;
            const current = sections.find((sec) => {
                const rect = sec.getBoundingClientRect();
                return rect.top <= probeY && rect.bottom > probeY;
            });
            const type = current?.dataset.nav;
            applyState(type === 'dark' ? 'dark' : type === 'type0' ? 'type0' : 'light');
        }

        let ticking = false;
        function onScroll() {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(() => {
                update();
                ticking = false;
            });
        }

        update();
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
    }
</script>

<script>
    // ===== 手機版漢堡選單開關 =====
    const mobileNav = document.querySelector<HTMLElement>('header nav .mobile');
    const burger = mobileNav?.querySelector<HTMLElement>('.burger');

    burger?.addEventListener('click', () => {
        mobileNav?.classList.toggle('is-open');
    });
</script>

<script>
    // ===== 手機版導覽列高度撐開（.menuHeight） =====
    // header nav 是 position: fixed 蓋在內容上面：桌機版靠 header.css 的 .menuHeight{height:0} 讓內容
    // 直接貼齊頂端（設計上是透明疊在首頁 Hero 上）；手機版的 .bar 是不透明實色列，下面的內容要往下推開
    // 才不會被蓋住。CSS 先給 56px 當初始/無 JS 時的靜態預設值，這裡再量測 .bar 實際渲染高度校正一次，
    // 避免不同裝置字體渲染、瀏覽器縮放等造成的高度誤差。
    const mobileBar = document.querySelector<HTMLElement>('header nav .mobile .bar');
    const menuHeight = document.querySelector<HTMLElement>('header .menuHeight');
    const mobileQuery = window.matchMedia('(max-width: 1023px)');

    function syncMenuHeight() {
        if (!mobileBar || !menuHeight) return;
        if (mobileQuery.matches) {
            menuHeight.style.height = `${mobileBar.getBoundingClientRect().height}px`;
        } else {
            menuHeight.style.removeProperty('height');
        }
    }

    syncMenuHeight();
    window.addEventListener('resize', syncMenuHeight);
    mobileQuery.addEventListener('change', syncMenuHeight);
</script>

<script>
    // ===== 手機版子選單開關 =====
    document.querySelectorAll<HTMLAnchorElement>('header nav .mobile .menuBox li.hasSub > a').forEach((link) => {
        link.addEventListener('click', (e) => {
            e.preventDefault();
            link.closest('li')?.classList.toggle('is-open');
        });
    });
</script>

<script>
    // ===== 點選「沒有子選單的按鈕」或「子選單裡的選項」時，收合手機版選單 =====
    // 排除「有子選單的主按鈕」本身（例如 AI最新趨勢），該按鈕點擊只負責展開/收合子選單
    const mobileNav = document.querySelector<HTMLElement>('header nav .mobile');
    document.querySelectorAll<HTMLAnchorElement>('header nav .mobile .menuBox a').forEach((link) => {
        const parentLi = link.closest('li');
        const isSubMenuToggle = parentLi?.classList.contains('hasSub') && link.parentElement === parentLi;
        if (isSubMenuToggle) return;

        link.addEventListener('click', () => {
            mobileNav?.classList.remove('is-open');
        });
    });
</script>
