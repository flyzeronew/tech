                                AI最新趨勢
                                <span class="arraw">
                                    <img width="20" height="20" src="/direction-down.svg" alt="arraw" />
                                </span>
                            </a>
                            <ul class="subMenu">
                                <li><a href="#">子選單1</a></li>
                                <li><a href="#">子選單2</a></li>
                            </ul>
                        </li>
                        <li>
                            <a href="#new" class="act">亞利桑那觀察</a>
                        </li>
                        <li>
