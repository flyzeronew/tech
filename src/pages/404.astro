---
import Layout from '../layouts/Layout.astro';
import '../styles/pages/not-found.css';
---
<Layout title="找不到頁面 | TVBS TECH">
    <section>
        <div id="notFound">
            <div class="inBox">
                <p class="code">404</p>
                <p class="title">找不到這個頁面</p>
                <p class="desc">您要找的頁面不存在，或已經被移除。</p>
                <a class="back" href="/">回到首頁</a>
            </div>
        </div>
    </section>
</Layout>
