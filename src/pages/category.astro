---
<Layout title="分類頁 | TVBS TECH">
    <section>
        <div id="category">
            <div class="kv">
                <div class="box">
                    <div class="img">
                        <img class="pc" width="1440" height="400" src="/main-view-02.jpg" alt="kv" />
                        <img class="mobile" width="428" height="240" src="/main-view-02-m.jpg" alt="kv" />
                    </div>
                </div>
            </div>
            <div class="inBox">
                <div class="cateTitle">
                    <p class="title">消費性電子</p>
                    <p class="en">EVERYDAY TECH</p>
                    <p class="description">
                        從掌中裝置到資本浪潮，解碼消費科技背後的產業商機。
                    </p>
                </div>
                <div class="breadcrumbs">
                    <a href="/">首頁</a>
                    <a href="/category">消費性電子</a>
                </div>

                <div class="list">
                    <ul>
                        {newsItems.map((item) => (
                            <li>
                                <a href={item.href}>
                                    <div class="news">
                                        <div class="img">
                                            <img width="96" height="54" src={item.image} alt="arraw" loading="lazy" />
                                        </div>
                                        <div class="titleBox">
                                            <div class="time">{item.date}</div>
                                            <div class="title">
                                                {item.title}
                                            </div>
                                            <div class="description">
                                                {item.description}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="arraw">
                                        <img width="24" height="24 " src="/arraw-right-04.svg" alt="arraw" />
                                    </div>
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
                <div class="more">
                    <a href="#">
                        <div class="text">
                            <span>更多新聞</span>
                        </div>
                        <div class="arraw">
                            <img width="24" height="24 " src="/arraw-right-01.svg" alt="arraw" />
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </section>
</Layout>
