---
import Layout from '../../layouts/Layout.astro';
import Adult from '../../components/article/Adult.astro';
import Share from '../../components/article/Share.astro';
import ArticleContent from '../../components/article/ArticleContent.astro';
import { fetchArticleDetail } from '../../lib/articleDetail';
import { CATEGORY_META } from '../../lib/categoryArticles';

const { category, id } = Astro.params;

if (!category || !CATEGORY_META[category] || !id) {
    return Astro.rewrite('/404');
}

const article = await fetchArticleDetail(category, id);
if (!article) {
    return Astro.rewrite('/404');
}

const pageTitle = `${article.title}｜TVBS TECH`;
// YouTube 影片模式（article.youtubeId 有值）時，og:image 改用影片縮圖，而不是文章主圖——
// 分享到社群時預覽圖才會跟嵌入的影片一致，不會出現文章圖片但點進去卻是影片的落差。
// hqdefault 是所有 YouTube 影片都保證有的縮圖尺寸（maxresdefault 並非每支影片都有）。
const ogImage = article.youtubeId
    ? `https://img.youtube.com/vi/${article.youtubeId}/hqdefault.jpg`
    : article.image;

const canonicalUrl = new URL(Astro.url.pathname, Astro.url.origin).toString();
const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: article.title,
    description: article.description,
    image: [article.image],
    datePublished: article.publishedAtISO ?? undefined,
    dateModified: article.updatedAtISO ?? article.publishedAtISO ?? undefined,
    mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalUrl,
    },
    author: article.authors.length > 0
        ? article.authors.map((a) => ({ '@type': 'Person', name: a.name }))
        : { '@type': 'Organization', name: 'TVBS TECH', url: Astro.url.origin },
    publisher: {
        '@type': 'Organization',
        name: 'TVBS TECH',
        logo: {
            '@type': 'ImageObject',
            url: new URL('/tvbs-logo-b.svg', Astro.url.origin).toString(),
        },
    },
};
---
<Layout
    title={pageTitle}
    description={article.description}
    ogTitle={pageTitle}
    ogDescription={article.description}
    ogImage={ogImage}
    ogUrl={canonicalUrl}
    ogType="article"
    jsonLd={jsonLd}
>
    <Adult show={article.isAdult} />
    <Share />
    <ArticleContent article={article} />
</Layout>
