---
import Layout from '../layouts/Layout.astro';
import '../styles/pages/experts.css';
import { fetchIndexExperts } from '../lib/indexExperts';

const experts = await fetchIndexExperts();

const canonicalUrl = new URL(Astro.url.pathname, Astro.url.origin).toString();
const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: '專家觀點',
    url: canonicalUrl,
    mainEntity: {
        '@type': 'ItemList',
        itemListElement: experts
            .filter((expert) => expert.slug)
            .map((expert, i) => ({
                '@type': 'ListItem',
                position: i + 1,
                item: {
                    '@type': 'Person',
                    name: expert.name,
                    description: expert.description,
                    ...(expert.avatar
                        ? { image: expert.avatar.startsWith('http') ? expert.avatar : new URL(expert.avatar, Astro.url.origin).toString() }
                        : {}),
                    url: new URL(`/experts/${expert.slug}`, Astro.url.origin).toString(),
                },
            })),
    },
};
---
<Layout
    title="專家觀點｜TVBS TECH"
    description="TVBS TECH 專家觀點，匯聚全球洞見與觀點，解讀複雜局勢背後的關鍵訊號。"
    jsonLd={jsonLd}
>
    <section data-nav="dark">
        <div id="expertsPage">
            <div class="inBox">
                <div class="headline">
                    <div class="left">
                        <div class="breadcrumbs">
                            <a href="/">首頁</a>
                            <a href="/experts">專家觀點</a>
                        </div>
                        <div class="cateTitle">
                            <p class="title">專家觀點</p>
                            <p class="en">THE EXPERTS</p>
                        </div>
                    </div>
                    <div class="description">
                        <p>匯聚全球頂尖智識，</p>
                        <p>解碼複雜變局背後的關鍵脈動。</p>
                    </div>
                </div>

                <div class="list">
                    {experts.map((expert) => (
                        <div class="author">
                            <div class="avatar">
                                <div class="img">
                                    {expert.avatar && <img width="137" height="137" src={expert.avatar} alt={expert.name} loading="lazy" />}
                                </div>
                            </div>
                            <div class="profile">
                                <div class="name">
                                    <p class="nameText">{expert.name}</p>
                                    <div class="labelGroup">
                                        {expert.tags.map((tag) => <span class="label">{tag}</span>)}
                                    </div>
                                </div>
                                {expert.description && <p class="desc">{expert.description}</p>}
                            </div>
                            <div class="content">
                                <div class="newsGroup">
                                    {expert.articles.map((article) => (
                                        <div class="newsRow">
                                            <a href={article.href}>
                                                <span class="rowTitle">{article.title}</span>
                                                <span class="arraw">
                                                    <img width="24" height="24" src="/arraw-right-03.svg" alt="arraw" />
                                                </span>
                                            </a>
                                        </div>
                                    ))}
                                </div>
                                <div class="more">
                                    <a href={`/experts/${expert.slug}`}>
                                        <span>完整介紹與觀點</span>
                                        <div class="arraw">
                                            <img width="24" height="24" src="/arraw-right-03.svg" alt="arraw" />
                                        </div>
                                    </a>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </section>
</Layout>
