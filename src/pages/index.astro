---
import '../styles/global.css';
import '../styles/components/header.css';
---
<html lang="zh-Hant">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>TVBS TECH</title>
		<meta name="keywords" content="">
		<meta name="description" content="">
		<meta property="og:title" content="">
		<meta property="og:image" content="">
		<link rel="icon" href="" type="image/icon">
	</head>
	<body>
		<h1 style="display: none;">TVBS TECH</h1>
		<header>
			<nav>
				<div class="frameBox">
					<div class="navBox">
						<div class="logo">
							<img width="164" height="24" src="/tvbs-logo.svg" alt="logo" />
						</div>
						<div class="menu">
							<a href="#">頭條</a>
							<a href="#">最新</a>
							<a href="#">專題</a>
							<a href="#">影音</a>
							<a href="#">財經</a>
							<a href="#">專欄</a>
