        <script>
            // ===== 精選出版品（#publications）書本清單：無限循環自動捲動、拖曳、左右按鈕 =====
            const books = document.querySelector<HTMLElement>('#publications .books');
            const booksList = books?.querySelector<HTMLUListElement>('ul');

            if (books && booksList) {
                // 複製一份清單內容接在後面，捲到一半時無縫接回開頭，做出無限循環的效果
                const originalItems = Array.from(booksList.children);
                originalItems.forEach((item) => {
                    const clone = item.cloneNode(true) as HTMLElement;
                    clone.setAttribute('aria-hidden', 'true');
                    booksList.appendChild(clone);
                });

                let isDown = false;
                let isHover = false;
                let startX = 0;
                let scrollStart = 0;

                books.addEventListener('pointerdown', (e) => {
                    isDown = true;
                    books.classList.add('dragging');
                    startX = e.clientX;
                    scrollStart = books.scrollLeft;
                    books.setPointerCapture(e.pointerId);
                });

                books.addEventListener('pointermove', (e) => {
                    if (!isDown) return;
                    books.scrollLeft = scrollStart - (e.clientX - startX);
                });

                let scrollPos = books.scrollLeft;

                const endDrag = () => {
                    isDown = false;
                    books.classList.remove('dragging');
                    scrollPos = books.scrollLeft;
                };

                books.addEventListener('pointerup', endDrag);
                books.addEventListener('pointercancel', endDrag);
                books.addEventListener('pointerleave', endDrag);

                books.addEventListener('pointerenter', () => { isHover = true; });
                books.addEventListener('pointerleave', () => { isHover = false; });

                let isManual = false;

                const speed = 0.3; // 每禎捲動的像素數
                function autoScroll() {
                    const loopWidth = booksList.scrollWidth / 2;
                    if (!isDown && !isHover && !isManual) {
                        // scrollLeft 在某些瀏覽器會被四捨五入成整數，直接用它累加小數會卡住，
                        // 所以改用獨立變數保留完整精度，只在寫入時才套用到 scrollLeft
                        scrollPos += speed;
                        if (scrollPos >= loopWidth) {
                            scrollPos -= loopWidth;
                        }
                        books.scrollLeft = scrollPos;
                    }
                    requestAnimationFrame(autoScroll);
                }
                requestAnimationFrame(autoScroll);

                // 左右按鍵：把目前位置平滑捲動到目標位置
                const step = 300;
                let scrollAnimFrame: number | null = null;
                function animateScrollBy(delta: number, duration = 400) {
                    if (scrollAnimFrame !== null) {
                        cancelAnimationFrame(scrollAnimFrame);
                        scrollAnimFrame = null;
                    }
                    isManual = true;
                    const loopWidth = booksList.scrollWidth / 2;
                    // 用畫面上「當下實際」的捲動位置當起點，避免連續點擊時從過期的 scrollPos 起跳造成跳動
                    const start = books.scrollLeft;
                    const target = start + delta;
                    const startTime = performance.now();

                    function tick(now: number) {
                        const t = Math.min((now - startTime) / duration, 1);
                        const eased = 1 - Math.pow(1 - t, 3);
                        let pos = start + (target - start) * eased;
                        if (pos < 0) pos += loopWidth;
                        if (pos >= loopWidth) pos -= loopWidth;
                        books.scrollLeft = pos;
                        if (t < 1) {
                            scrollAnimFrame = requestAnimationFrame(tick);
                        } else {
                            scrollPos = pos;
                            isManual = false;
                            scrollAnimFrame = null;
                        }
                    }
                    scrollAnimFrame = requestAnimationFrame(tick);
                }

                const prevBtn = document.querySelector<HTMLButtonElement>('#publications .booksPrev');
                const nextBtn = document.querySelector<HTMLButtonElement>('#publications .booksNext');
                prevBtn?.addEventListener('click', () => animateScrollBy(-step));
                nextBtn?.addEventListener('click', () => animateScrollBy(step));
            }

            // ===== 編輯選讀（#editorPick）影響 AI 的十件事清單：拖曳捲動、左右按鈕 =====
            const moreList = document.querySelector<HTMLElement>('#editorPick .moreArea .list');
            if (moreList) {
                let isDown = false;
                let startX = 0;
                let scrollStart = 0;

                moreList.addEventListener('pointerdown', (e) => {
                    isDown = true;
                    moreList.classList.add('dragging');
                    startX = e.clientX;
                    scrollStart = moreList.scrollLeft;
                    moreList.setPointerCapture(e.pointerId);
                });

                moreList.addEventListener('pointermove', (e) => {
                    if (!isDown) return;
                    moreList.scrollLeft = scrollStart - (e.clientX - startX);
                });

                const endDrag = () => {
                    isDown = false;
                    moreList.classList.remove('dragging');
                };

                moreList.addEventListener('pointerup', endDrag);
                moreList.addEventListener('pointercancel', endDrag);
                moreList.addEventListener('pointerleave', endDrag);

                // 左右按鍵：平滑捲動到目標位置
                const morePrevBtn = document.querySelector<HTMLButtonElement>('#editorPick .moreArea .btn .prevBtn');
                const moreNextBtn = document.querySelector<HTMLButtonElement>('#editorPick .moreArea .btn .nextBtn');
                const moreStep = 300;
                let moreScrollAnimFrame: number | null = null;
                function animateMoreListScrollBy(delta: number, duration = 400) {
                    if (moreScrollAnimFrame !== null) {
                        cancelAnimationFrame(moreScrollAnimFrame);
                        moreScrollAnimFrame = null;
                    }
                    const start = moreList.scrollLeft;
                    const target = start + delta;
                    const startTime = performance.now();

                    function tick(now: number) {
                        const t = Math.min((now - startTime) / duration, 1);
                        const eased = 1 - Math.pow(1 - t, 3);
                        moreList.scrollLeft = start + (target - start) * eased;
                        if (t < 1) {
                            moreScrollAnimFrame = requestAnimationFrame(tick);
                        } else {
                            moreScrollAnimFrame = null;
                        }
                    }
                    moreScrollAnimFrame = requestAnimationFrame(tick);
                }
                morePrevBtn?.addEventListener('click', () => animateMoreListScrollBy(-moreStep));
                moreNextBtn?.addEventListener('click', () => animateMoreListScrollBy(moreStep));
            }
        </script>
    </body>
</html>
