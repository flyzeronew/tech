							<div class="img">
								<img width="1440" height="400" src="/main-view-01.jpg" alt="kv" />
							</div>
						</div>
					</div>
				</div>
			</div>
		</header>
		<main>
			<section></section>
		</main>
		<footer></footer>
	</body>
</html>
