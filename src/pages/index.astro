---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/index/Hero.astro';
import New from '../components/index/New.astro';
import Issue from '../components/index/Issue.astro';
import Video from '../components/index/Video.astro';
import Crossover from '../components/index/Crossover.astro';
import Tech from '../components/index/Tech.astro';
import Experts from '../components/index/Experts.astro';
import Publications from '../components/index/Publications.astro';
import EditorPick from '../components/index/EditorPick.astro';
import TechLeaders from '../components/index/TechLeaders.astro';
import Partners from '../components/index/Partners.astro';

const siteOrigin = Astro.url.origin;
const jsonLd = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'Organization',
            '@id': `${siteOrigin}/#organization`,
            name: 'TVBS TECH',
            url: siteOrigin,
            logo: {
                '@type': 'ImageObject',
                url: new URL('/tvbs-logo-b.svg', siteOrigin).toString(),
            },
        },
        {
            '@type': 'WebSite',
            '@id': `${siteOrigin}/#website`,
            name: 'TVBS TECH',
            url: siteOrigin,
            publisher: { '@id': `${siteOrigin}/#organization` },
        },
    ],
};
---
<Layout jsonLd={jsonLd}>
    <Hero />
    <New />
    <Issue />
    <Video />
    <Crossover />
    <Tech />
    <Experts />
    <Publications />
    <EditorPick />
    <TechLeaders />
    <Partners />
</Layout>
