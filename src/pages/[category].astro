---
import Layout from '../layouts/Layout.astro';
import '../styles/pages/category.css';
import { fetchCategoryArticles, CATEGORY_ARTICLES_PAGE_SIZE, CATEGORY_META } from '../lib/categoryArticles';

const { category } = Astro.params;
const meta = category ? CATEGORY_META[category] : undefined;
if (!meta) {
    return Astro.rewrite('/404');
}

const { articles, total } = await fetchCategoryArticles(category!, 1);
const hasMore = CATEGORY_ARTICLES_PAGE_SIZE < total;

const pageTitle = `${meta.title}｜TVBS TECH`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.url.origin).toString();
const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: meta.title,
    description: meta.description,
    url: canonicalUrl,
    mainEntity: {
        '@type': 'ItemList',
        itemListElement: articles.map((item, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            url: new URL(item.href, Astro.url.origin).toString(),
            name: item.title,
        })),
    },
};
---
<Layout
    title={pageTitle}
    description={meta.metaDescription}
    ogTitle={pageTitle}
    ogDescription={meta.metaDescription}
    ogType="website"
    jsonLd={jsonLd}
>
    <section>
        <div id="category">
            <div class="kv">
                <div class="box">
                    <div class="img">
                        <img width="1440" height="400" src="/main-view-02.jpg" alt="kv" />
                    </div>
                </div>
            </div>
            <div class="inBox">
                <div class="cateTitle">
                    <p class="title">{meta.title}</p>
                    <p class="en">{meta.en}</p>
                    <p class="description">
                        {meta.description}
                    </p>
                </div>
                <div class="breadcrumbs">
                    <a href="/">首頁</a>
                    <a href={`/${category}`}>{meta.title}</a>
                </div>

                <div class="list" data-category={category} data-page="1">
                    <ul id="newsList">
                        {articles.map((item) => (
                            <li>
                                <a href={item.href}>
                                    <div class="news">
                                        <div class="img">
                                            <img width="96" height="54" src={item.image} alt="arraw" loading="lazy" />
                                        </div>
                                        <div class="titleBox">
                                            <div class="time">{item.date}</div>
                                            <div class="title">
                                                {item.title}
                                            </div>
                                            <div class="description">
                                                {item.description}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="arraw">
                                        <img width="24" height="24 " src="/arraw-right-04.svg" alt="arraw" />
                                    </div>
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
                {hasMore && (
                    <div class="more" id="moreControl">
                        <button type="button">
                            <div class="text">
                                <span>更多新聞</span>
                            </div>
                            <div class="arraw">
                                <img width="24" height="24 " src="/arraw-right-01.svg" alt="arraw" />
                            </div>
                        </button>
                    </div>
                )}
            </div>
        </div>
    </section>
</Layout>

<script>
    // ===== 分類頁文章分頁載入（每次 10 則） =====
    // Strapi Token 是 server-only 密鑰，前端不能直接打 Strapi，所以「更多新聞」改成呼叫站內的
    // /api/category-articles 代理端點，由伺服器端用密鑰去查 Strapi 再把結果轉發回來。
    (() => {
        const list = document.querySelector<HTMLElement>('#category .list');
        const ul = document.getElementById('newsList');
        const moreControl = document.getElementById('moreControl');
        if (!list || !ul || !moreControl) return;

        const category = list.dataset.category ?? '';
        let page = Number(list.dataset.page ?? '1');

        interface ArticleItem {
            date: string;
            image: string;
            title: string;
            description: string;
            href: string;
        }

        function createItem(item: ArticleItem): HTMLElement {
            const li = document.createElement('li');

            const a = document.createElement('a');
            a.href = item.href;

            const news = document.createElement('div');
            news.className = 'news';

            const imgBox = document.createElement('div');
            imgBox.className = 'img';
            const img = document.createElement('img');
            img.width = 96;
            img.height = 54;
            img.src = item.image;
            img.alt = 'arraw';
            img.loading = 'lazy';
            imgBox.appendChild(img);

            const titleBox = document.createElement('div');
            titleBox.className = 'titleBox';
            const time = document.createElement('div');
            time.className = 'time';
            time.textContent = item.date;
            const title = document.createElement('div');
            title.className = 'title';
            title.textContent = item.title;
            const desc = document.createElement('div');
            desc.className = 'description';
            desc.textContent = item.description;
            titleBox.append(time, title, desc);

            news.append(imgBox, titleBox);

            const arraw = document.createElement('div');
            arraw.className = 'arraw';
            const arrowImg = document.createElement('img');
            arrowImg.width = 24;
            arrowImg.height = 24;
            arrowImg.src = '/arraw-right-04.svg';
            arrowImg.alt = 'arraw';
            arraw.appendChild(arrowImg);

            a.append(news, arraw);
            li.appendChild(a);
            return li;
        }

        const button = moreControl.querySelector('button');
        button?.addEventListener('click', async () => {
            button.disabled = true;
            page += 1;
            try {
                const res = await fetch(`/api/category-articles?category=${encodeURIComponent(category)}&page=${page}`);
                if (!res.ok) return;
                const json: { articles: ArticleItem[]; hasMore: boolean } = await res.json();
                json.articles.forEach((item) => ul.appendChild(createItem(item)));
                if (!json.hasMore) {
                    const noMore = document.createElement('p');
                    noMore.className = 'noMore';
                    noMore.textContent = '----　沒有更多文章　----';
                    moreControl.replaceWith(noMore);
                }
            } finally {
                button.disabled = false;
            }
        });
    })();
</script>
